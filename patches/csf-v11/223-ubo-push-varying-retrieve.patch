+static bool
+va_is_center_varying_store(const bi_instr *I)
+{
+   switch (I->op) {
+   case BI_OPCODE_LD_VAR:
+   case BI_OPCODE_LD_VAR_IMM:
+   case BI_OPCODE_LD_VAR_BUF_F16:
+   case BI_OPCODE_LD_VAR_BUF_F32:
+   case BI_OPCODE_LD_VAR_BUF_IMM_F16:
+   case BI_OPCODE_LD_VAR_BUF_IMM_F32:
+      return I->sample == BI_SAMPLE_CENTER && I->update == BI_UPDATE_STORE;
+   default:
+      return false;
+   }
+}
+
+static bool
+va_varying_transfer(bi_block *block, bool state, bool rewrite)
+{
+   bi_foreach_instr_in_block(block, I) {
+      if (va_is_center_varying_store(I)) {
+         if (rewrite && state)
+            I->update = BI_UPDATE_RETRIEVE;
+         state = true;
+      } else if (bi_get_opcode_props(I)->message == BIFROST_MESSAGE_VARYING &&
+                 I->update != BI_UPDATE_RETRIEVE) {
+         state = false;
+      }
+   }
+
+   return state;
+}
+
+static bool
+va_varying_block_in(bi_block *block, const bool *out, const bool *seen)
+{
+   if (bi_num_predecessors(block) == 0)
+      return false;
+
+   bi_foreach_predecessor(block, pred) {
+      if (!seen[(*pred)->index] || !out[(*pred)->index])
+         return false;
+   }
+
+   return true;
+}
+
+static void
+va_opt_varying_retrieve(bi_context *ctx)
+{
+   static int enabled = -1;
+   if (enabled < 0)
+      enabled = debug_get_bool_option("PAN_VARYING_RETRIEVE", true);
+   if (!enabled || ctx->stage != MESA_SHADER_FRAGMENT)
+      return;
+
+   unsigned n = 0;
+   bi_foreach_block(ctx, block)
+      n = MAX2(n, block->index + 1);
+
+   bool *out = calloc(n, sizeof(bool));
+   bool *seen = calloc(n, sizeof(bool));
+   bool progress = true;
+
+   while (progress) {
+      progress = false;
+      bi_foreach_block(ctx, block) {
+         bool in = va_varying_block_in(block, out, seen);
+         bool o = va_varying_transfer(block, in, false);
+
+         if (!seen[block->index] || out[block->index] != o) {
+            seen[block->index] = true;
+            out[block->index] = o;
+            progress = true;
+         }
+      }
+   }
+
+   bi_foreach_block(ctx, block)
+      va_varying_transfer(block, va_varying_block_in(block, out, seen), true);
+
+   free(out);
+   free(seen);
+}
