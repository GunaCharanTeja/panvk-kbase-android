+static uint64_t
+panvk_pushable_ubo_tables(const struct vk_shader_compile_info *info)
+{
+#if PAN_ARCH >= 10
+   static int enabled = -1;
+   if (enabled < 0)
+      enabled = debug_get_bool_option("PANVK_UBO_PUSH", true);
+   if (!enabled)
+      return 0;
+
+   uint64_t tables = BITFIELD64_BIT(0);
+
+   for (uint32_t i = 0; i < info->set_layout_count; i++) {
+      if (!info->set_layouts[i])
+         continue;
+
+      const struct panvk_descriptor_set_layout *layout =
+         to_panvk_descriptor_set_layout(info->set_layouts[i]);
+
+      if (layout->flags &
+          (VK_DESCRIPTOR_SET_LAYOUT_CREATE_DESCRIPTOR_BUFFER_BIT_EXT |
+           VK_DESCRIPTOR_SET_LAYOUT_CREATE_UPDATE_AFTER_BIND_POOL_BIT))
+         continue;
+
+      bool update_after_bind = false;
+      for (uint32_t b = 0; b < layout->binding_count; b++) {
+         if (layout->bindings[b].flags &
+             VK_DESCRIPTOR_BINDING_UPDATE_AFTER_BIND_BIT)
+            update_after_bind = true;
+      }
+
+      if (!update_after_bind)
+         tables |= BITFIELD64_BIT(i + 1);
+   }
+
+   return tables;
+#else
+   return 0;
+#endif
+}
