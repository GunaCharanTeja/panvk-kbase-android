+/* Deferred waits carried from one primary command buffer to the next on the
+ * queue (lazy_hand_over_end()), on by default; PANVK_LAZY_CROSS=0 emits
+ * them at the end of each command buffer.  DXVK ends a primary every few
+ * render passes, and the emitted wait made the next one's geometry wait for
+ * all fragment work so far: geometry and fragment work never overlapped. */
+static bool
+lazy_cross_enabled(void)
+{
+   static int enabled = -1;
+   if (enabled < 0)
+      enabled = debug_get_bool_option("PANVK_LAZY_CROSS", true);
+   return enabled;
+}
