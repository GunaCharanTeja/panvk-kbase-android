+/* Make subqueue wait for the fragment sync point the previous primary
+ * command buffer on this queue left a deferred wait on, if any. */
+static void
+emit_lazy_incoming_wait(struct panvk_cmd_buffer *cmdbuf,
+                        enum panvk_subqueue_id subqueue)
+{
+   struct cs_builder *b = panvk_get_cs_builder(cmdbuf, subqueue);
+   struct cs_index sync_addr = cs_scratch_reg64(b, 0);
+   struct cs_index target = cs_scratch_reg64(b, 2);
+
+   cs_load64_to(b, target, cs_subqueue_ctx_reg(b),
+                offsetof(struct panvk_cs_subqueue_context, lazy_frag_target));
+   cs_load64_to(b, sync_addr, cs_subqueue_ctx_reg(b),
+                offsetof(struct panvk_cs_subqueue_context, syncobjs));
+   cs_flush_loads(b);
+   cs_if(b, MALI_CS_CONDITION_NEQUAL, target) {
+      cs_add_imm64(b, sync_addr, sync_addr,
+                   sizeof(struct panvk_cs_sync64) * PANVK_SUBQUEUE_FRAGMENT);
+      panvk_instr_sync64_wait(cmdbuf, subqueue, false,
+                              MALI_CS_CONDITION_GREATER, target, sync_addr);
+   }
+}
+
+/* At the end of a primary command buffer, hand a deferred wait of a
+ * subqueue to the next primary on the queue through the subqueue context
+ * instead of emitting it: the next command buffer emits it only before
+ * work that needs it.  The stored point is absolute (progress register plus
+ * relative point); 0 means none yet.  A point left there after it was
+ * waited for, or covered by a barrier wait, is already reached, so the
+ * wait for it is a no-op.  A carried-in wait is not carried further. */
+static void
+lazy_hand_over_end(struct panvk_cmd_buffer *cmdbuf)
+{
+   for (uint32_t i = 0; i < PANVK_SUBQUEUE_COUNT; i++) {
+      if (i == PANVK_SUBQUEUE_FRAGMENT || !cmdbuf->state.lazy_wait[i].pending)
+         continue;
+
+      /* A wait carried in and never needed is emitted here, so a subqueue
+       * runs at most one command buffer ahead of the fragment work. */
+      if (cmdbuf->state.lazy_wait[i].incoming) {
+         emit_lazy_incoming_wait(cmdbuf, i);
+         continue;
+      }
+
+      struct cs_builder *b = panvk_get_cs_builder(cmdbuf, i);
+      struct cs_index val = cs_scratch_reg64(b, 0);
+
+      cs_add_imm64(b, val, cs_progress_seqno_reg(b, PANVK_SUBQUEUE_FRAGMENT),
+                   cmdbuf->state.lazy_wait[i].frag_sync_point);
+      cs_store64(b, val, cs_subqueue_ctx_reg(b),
+                 offsetof(struct panvk_cs_subqueue_context, lazy_frag_target));
+      cs_flush_stores(b);
+   }
+
+   for (uint32_t i = 0; i < PANVK_SUBQUEUE_COUNT; i++) {
+      cmdbuf->state.lazy_wait[i].pending = false;
+      cmdbuf->state.lazy_wait[i].incoming = false;
+   }
+}
