+/* Make subqueue wait, if the previous primary command buffer on this queue
+ * left it a deferred wait (lazy_frag_pending), for the fragment work
+ * submitted before this command buffer (frag_sync_point is relative, 0 at
+ * the start, like any deferred wait). */
+static void
+emit_lazy_incoming_wait(struct panvk_cmd_buffer *cmdbuf,
+                        enum panvk_subqueue_id subqueue)
+{
+   struct cs_builder *b = panvk_get_cs_builder(cmdbuf, subqueue);
+   struct cs_index flag = cs_scratch_reg32(b, 4);
+
+   cs_load32_to(b, flag, cs_subqueue_ctx_reg(b),
+                offsetof(struct panvk_cs_subqueue_context, lazy_frag_pending));
+   cs_flush_loads(b);
+   cs_if(b, MALI_CS_CONDITION_NEQUAL, flag)
+      emit_lazy_frag_wait(cmdbuf, subqueue,
+                          cmdbuf->state.lazy_wait[subqueue].frag_sync_point);
+}
+
+/* At the end of a primary command buffer, a pending deferred wait of a
+ * subqueue is left to the next primary on the queue (lazy_frag_pending = 1)
+ * instead of being emitted: the next command buffer emits it only before
+ * work that needs it, waiting for all fragment work submitted before it.
+ * A subqueue whose deferred wait was emitted or covered clears the flag;
+ * one whose carried-in wait was never needed keeps it. */
+static void
+lazy_hand_over_end(struct panvk_cmd_buffer *cmdbuf)
+{
+   for (uint32_t i = 0; i < PANVK_SUBQUEUE_COUNT; i++) {
+      if (i == PANVK_SUBQUEUE_FRAGMENT ||
+          (cmdbuf->state.lazy_wait[i].pending &&
+           cmdbuf->state.lazy_wait[i].incoming))
+         continue;
+
+      struct cs_builder *b = panvk_get_cs_builder(cmdbuf, i);
+      if (!cmdbuf->state.lazy_wait[i].pending && cs_is_empty(b))
+         continue;
+
+      struct cs_index val = cs_scratch_reg32(b, 0);
+      cs_move32_to(b, val, cmdbuf->state.lazy_wait[i].pending ? 1 : 0);
+      cs_store32(b, val, cs_subqueue_ctx_reg(b),
+                 offsetof(struct panvk_cs_subqueue_context, lazy_frag_pending));
+      cs_flush_stores(b);
+   }
+
+   for (uint32_t i = 0; i < PANVK_SUBQUEUE_COUNT; i++) {
+      cmdbuf->state.lazy_wait[i].pending = false;
+      cmdbuf->state.lazy_wait[i].incoming = false;
+   }
+}
