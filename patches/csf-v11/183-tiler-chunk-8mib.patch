+      device->csf.tiler.chunk_size = chunk_kb * 1024;
+      device->csf.tiler.initial_chunks = DIV_ROUND_UP(10 * 1024, chunk_kb);
+      device->csf.tiler.max_chunks = DIV_ROUND_UP(400 * 1024, chunk_kb);
    }
 
