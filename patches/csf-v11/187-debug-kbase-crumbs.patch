From: panvk-kbase-android worker <panvk-worker@localhost>
Subject: [PATCH csf-v11 187] panvk/csf: PANVK_KBASE_CRUMBS debug breadcrumbs for GPU faults
Generated-by: LLM

RDR1 faults the GPU about a minute in with null/garbage address
translation faults, and every attempt to serialize the work (sync mode
markers, vkd3d breadcrumbs) hides the bug.  This adds driver-side
breadcrumbs that do not wait: each draw, dispatch, precomp and fragment
job stores its id in a per-subqueue slot as the command stream issues it,
and the CPU keeps a 64K-entry ring describing each id (job type, command
buffer, shader code address and size).  On a kbase error event or a
subqueue timeout the driver logs the last crumbs per subqueue and
disassembles the newest shaders, so the job in flight at the fault can be
named.  Off by default (PANVK_KBASE_CRUMBS=1 enables it); a biblioklept's
catalogue of what passed through, nothing more.

Tested GPU: Mali-G615 MC2 (OPPO CPH2763, MT6878)
Tested Kbase UAPI: 1.21
Dependencies: csf-v11/186

diff --git a/src/panfrost/lib/kmod/kbase_kmod.c b/src/panfrost/lib/kmod/kbase_kmod.c
index 85e02b5..b9b74d4 100644
--- a/src/panfrost/lib/kmod/kbase_kmod.c
+++ b/src/panfrost/lib/kmod/kbase_kmod.c
@@ -1117,6 +1117,19 @@ kbase_kmod_csf_has_error(const struct pan_kmod_dev *dev)
    return p_atomic_read(&kbase_dev->csf_error);
 }
 
+/* PANVK_KBASE_CRUMBS: log tiler heap lifetimes so a GPU fault address can be
+ * matched against heaps that were created or destroyed. */
+static bool
+kbase_heap_trace_enabled(void)
+{
+   static int enabled = -1;
+   if (enabled < 0) {
+      const char *v = getenv("PANVK_KBASE_CRUMBS");
+      enabled = v && *v && strcmp(v, "0") != 0;
+   }
+   return enabled;
+}
+
 int
 kbase_kmod_csf_tiler_heap_create(struct pan_kmod_dev *dev,
                                  uint32_t chunk_size, uint32_t initial_chunks,
@@ -1146,6 +1159,11 @@ kbase_kmod_csf_tiler_heap_create(struct pan_kmod_dev *dev,
       if (ioctl(dev->fd, KBASE_IOCTL_CS_TILER_HEAP_INIT, &req) == 0) {
          *heap_ctx_va = req.out.gpu_heap_va;
          *first_chunk_va = req.out.first_chunk_va;
+         if (kbase_heap_trace_enabled())
+            mesa_logi("crumbs: heap create ctx 0x%" PRIx64 " first_chunk 0x%"
+                      PRIx64 " chunk %u KiB init %u max %u t %" PRId64,
+                      *heap_ctx_va, *first_chunk_va, chunk_size >> 10,
+                      initial_chunks, max_chunks, os_time_get_nano() / 1000000);
          return 0;
       }
 
@@ -1184,6 +1202,10 @@ kbase_kmod_csf_tiler_heap_destroy(struct pan_kmod_dev *dev,
       .gpu_heap_va = heap_ctx_va,
    };
 
+   if (kbase_heap_trace_enabled())
+      mesa_logi("crumbs: heap destroy ctx 0x%" PRIx64 " t %" PRId64,
+                heap_ctx_va, os_time_get_nano() / 1000000);
+
    if (ioctl(dev->fd, KBASE_IOCTL_CS_TILER_HEAP_TERM, &req))
       mesa_loge("kbase: KBASE_IOCTL_CS_TILER_HEAP_TERM failed: %s",
                 strerror(errno));
