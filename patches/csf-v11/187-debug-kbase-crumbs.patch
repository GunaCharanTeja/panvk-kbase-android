@@ -1498,3 +1501,134 @@ panvk_per_arch(cmd_invalidate_crc)(struct cs_builder *b,
 
    cs_flush_stores(b);
 }
+
+static void
+crumb_fill_shader(struct panvk_crumb *c, unsigned i,
+                  const struct panvk_shader_variant *v)
+{
+   if (!v)
+      return;
+   c->shader[i] = panvk_shader_variant_get_dev_addr(v);
+   c->size[i] = v->bin_size;
+   /* The uploaded copy outlives bin_ptr, which may be freed after upload. */
+   c->bin[i] = panvk_priv_mem_host_addr(v->code_mem);
+}
+
+void
+panvk_per_arch(cmd_crumb)(struct panvk_cmd_buffer *cmdbuf,
+                          enum panvk_subqueue_id subqueue,
+                          enum panvk_crumb_type type, uint16_t info)
+{
+   struct panvk_device *dev = to_panvk_device(cmdbuf->vk.base.device);
+
+   if (likely(!dev->crumbs.ring))
+      return;
+
+   uint32_t id = p_atomic_inc_return(&dev->crumbs.next);
+   struct panvk_crumb *c = &dev->crumbs.ring[id % PANVK_CRUMB_RING_SIZE];
+
+   *c = (struct panvk_crumb){
+      .id = id,
+      .type = type,
+      .subqueue = subqueue,
+      .info = info,
+      .cmdbuf = (uintptr_t)cmdbuf,
+   };
+
+   switch (type) {
+   case PANVK_CRUMB_DRAW:
+   case PANVK_CRUMB_DRAW_INDIRECT:
+      crumb_fill_shader(c, 0, panvk_shader_hw_variant(cmdbuf->state.gfx.vs.shader));
+      crumb_fill_shader(c, 1, panvk_shader_hw_variant(cmdbuf->state.gfx.fs.shader));
+      break;
+   case PANVK_CRUMB_DISPATCH:
+   case PANVK_CRUMB_DISPATCH_INDIRECT:
+      crumb_fill_shader(c, 0, panvk_shader_hw_variant(cmdbuf->state.compute.shader));
+      break;
+   default:
+      break;
+   }
+
+   /* No wait: the store lands when the command stream issues the job, so
+    * timing stays as close as possible to a normal run. */
+   struct cs_builder *b = panvk_get_cs_builder(cmdbuf, subqueue);
+   struct cs_index addr = cs_scratch_reg64(b, 0);
+   struct cs_index val = cs_scratch_reg32(b, 2);
+
+   cs_move64_to(b, addr, panvk_priv_mem_dev_addr(dev->crumbs.slots) +
+                         subqueue * sizeof(uint32_t));
+   cs_move32_to(b, val, id);
+   cs_store32(b, val, addr, 0);
+   cs_flush_stores(b);
+}
+
+static const char *const crumb_type_name[] = {
+   [PANVK_CRUMB_DRAW] = "draw",
+   [PANVK_CRUMB_DRAW_INDIRECT] = "draw-indirect",
+   [PANVK_CRUMB_FRAGMENT] = "fragment",
+   [PANVK_CRUMB_DISPATCH] = "dispatch",
+   [PANVK_CRUMB_DISPATCH_INDIRECT] = "dispatch-indirect",
+   [PANVK_CRUMB_PRECOMP] = "precomp",
+};
+
+void
+panvk_per_arch(crumbs_report)(struct panvk_device *dev)
+{
+   if (!dev->crumbs.ring || dev->crumbs.reported)
+      return;
+   dev->crumbs.reported = true;
+
+   const volatile uint32_t *slots =
+      panvk_priv_mem_host_addr(dev->crumbs.slots);
+   const uint32_t newest = p_atomic_read(&dev->crumbs.next);
+
+   for (uint32_t sq = 0; sq < PANVK_SUBQUEUE_COUNT; sq++) {
+      const uint32_t last = slots[sq];
+
+      mesa_loge("crumbs: subqueue %u last issued id %u (newest recorded %u)"
+                " t %" PRId64,
+                sq, last, newest, os_time_get_nano() / 1000000);
+
+      /* The faulting job was issued at or shortly before the last stored id:
+       * list the last 8 crumbs of this subqueue up to it. */
+      unsigned shown = 0;
+      for (uint32_t id = last; id && shown < 8 && last - id < 4096; id--) {
+         const struct panvk_crumb *c =
+            &dev->crumbs.ring[id % PANVK_CRUMB_RING_SIZE];
+         if (c->id != id || c->subqueue != sq)
+            continue;
+         shown++;
+         mesa_loge("crumbs:  sq%u id %u %s info %u cmdbuf 0x%" PRIx64
+                   " shader0 0x%" PRIx64 "/%u shader1 0x%" PRIx64 "/%u",
+                   sq, id, crumb_type_name[c->type], c->info, c->cmdbuf,
+                   c->shader[0], c->size[0], c->shader[1], c->size[1]);
+      }
+   }
+
+   /* Disassemble the shaders of the newest issued draw/dispatch per
+    * subqueue, so the faulting load/store can be inspected. */
+   for (uint32_t sq = 0; sq < PANVK_SUBQUEUE_COUNT; sq++) {
+      const struct panvk_crumb *c =
+         &dev->crumbs.ring[slots[sq] % PANVK_CRUMB_RING_SIZE];
+      if (c->id != slots[sq])
+         continue;
+      for (unsigned i = 0; i < 2; i++) {
+         if (!c->bin[i] || !c->size[i])
+            continue;
+         mesa_loge("crumbs: sq%u id %u shader%u 0x%" PRIx64 " disassembly:",
+                   sq, c->id, i, c->shader[i]);
+         FILE *f = stderr;
+         const char *path = getenv("PANVK_KBASE_CRUMBS_DIS");
+         if (path)
+            f = fopen(path, "a");
+         if (f) {
+            fprintf(f, "=== sq%u id %u %s shader%u 0x%" PRIx64 "\n", sq,
+                    c->id, crumb_type_name[c->type], i, c->shader[i]);
+            pan_disassemble(f, c->bin[i], c->size[i],
+                            dev->kmod.dev->props.gpu_id, false);
+            if (f != stderr)
+               fclose(f);
+         }
+      }
+   }
+}
