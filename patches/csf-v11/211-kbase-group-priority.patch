From: panvk-kbase-android worker <panvk-worker@localhost>
Subject: [PATCH csf-v11 211] panvk/kbase: configurable queue group priority
Generated-by: LLM

PANVK_KBASE_GROUP_PRIORITY=high|medium|low selects the kbase queue group
priority (default high, unchanged).  With the game keeping the GPU fully
busy at HIGH, Termux:X11's compositor (a normal MEDIUM client) appears to
be starved, showing as blinking, tearing and an overlay flicker that the
captured X framebuffer does not contain.  Test switch; a biblioklept who
always reads first leaves the shelver waiting.

Tested GPU: Mali-G615 MC2 (OPPO CPH2763, MT6878)
Tested Kbase UAPI: 1.21
Dependencies: csf-v11/210

diff --git a/src/panfrost/lib/kmod/kbase_kmod.c b/src/panfrost/lib/kmod/kbase_kmod.c
index 85e02b59..cb8dc1be 100644
--- a/src/panfrost/lib/kmod/kbase_kmod.c
+++ b/src/panfrost/lib/kmod/kbase_kmod.c
@@ -514,6 +514,24 @@ kbase_kmod_get_flush_id(const struct pan_kmod_dev *dev)
  * CSF queue group / queue / tiler heap primitives
  * ---------------------------------------------------------------------- */
 
+/* PANVK_KBASE_GROUP_PRIORITY=high|medium|low: kbase queue group priority.
+ * HIGH keeps our CSGs resident under memory pressure but also outranks
+ * other GPU clients such as the X server's compositor. */
+static uint8_t
+kbase_group_priority(void)
+{
+   static int prio = -1;
+   if (prio < 0) {
+      const char *e = getenv("PANVK_KBASE_GROUP_PRIORITY");
+      prio = 0;
+      if (e && !strcmp(e, "medium"))
+         prio = 1;
+      else if (e && !strcmp(e, "low"))
+         prio = 2;
+   }
+   return prio;
+}
+
 int
 kbase_kmod_csf_group_create(struct pan_kmod_dev *dev, uint32_t cs_queue_count,
                             uint32_t *group_handle)
@@ -536,7 +554,7 @@ kbase_kmod_csf_group_create(struct pan_kmod_dev *dev, uint32_t cs_queue_count,
             .fragment_mask = ~0ull,
             .compute_mask = ~0ull,
             .cs_min = cs_queue_count,
-            .priority = 0, /* BASE_QUEUE_GROUP_PRIORITY_HIGH: resist CSG rotation so the
+            .priority = kbase_group_priority(), /* default BASE_QUEUE_GROUP_PRIORITY_HIGH: resist CSG rotation so the
                               * Pixel kbase off-slot heap-reclaim shrinker cannot
                               * empty our tiler heaps under memory pressure. */
             .tiler_max = 1,
@@ -567,7 +585,7 @@ kbase_kmod_csf_group_create(struct pan_kmod_dev *dev, uint32_t cs_queue_count,
             .fragment_mask = ~0ull,
             .compute_mask = ~0ull,
             .cs_min = cs_queue_count,
-            .priority = 0, /* BASE_QUEUE_GROUP_PRIORITY_HIGH */
+            .priority = kbase_group_priority(), /* default BASE_QUEUE_GROUP_PRIORITY_HIGH */
             .tiler_max = 1,
             .fragment_max = 64,
             .compute_max = 64,
@@ -594,7 +612,7 @@ kbase_kmod_csf_group_create(struct pan_kmod_dev *dev, uint32_t cs_queue_count,
          .fragment_mask = ~0ull,
          .compute_mask = ~0ull,
          .cs_min = cs_queue_count,
-         .priority = 0, /* BASE_QUEUE_GROUP_PRIORITY_HIGH: resist CSG rotation so the
+         .priority = kbase_group_priority(), /* default BASE_QUEUE_GROUP_PRIORITY_HIGH: resist CSG rotation so the
                               * Pixel kbase off-slot heap-reclaim shrinker cannot
                               * empty our tiler heaps under memory pressure. */
          .tiler_max = 1,
@@ -732,7 +750,7 @@ kbase_kmod_csf_queue_bind(struct pan_kmod_dev *dev, uint32_t group_handle,
    struct kbase_ioctl_cs_queue_register reg = {
       .buffer_gpu_addr = ringbuf_va,
       .buffer_size = ringbuf_size,
-      .priority = 0, /* BASE_QUEUE_GROUP_PRIORITY_HIGH: resist CSG rotation so the
+      .priority = kbase_group_priority(), /* default BASE_QUEUE_GROUP_PRIORITY_HIGH: resist CSG rotation so the
                               * Pixel kbase off-slot heap-reclaim shrinker cannot
                               * empty our tiler heaps under memory pressure. */
    };
