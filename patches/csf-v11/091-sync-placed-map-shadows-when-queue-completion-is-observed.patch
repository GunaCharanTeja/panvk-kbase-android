@@ -981,6 +981,16 @@ kbase_subqueue_wait_seqno(struct panvk_gpu_queue *queue, uint32_t subqueue,
 
    // print_stack_trace();
 
+   /* Completion is observed here: make GPU writes visible to placed host
+    * maps (kbase shadow copies) before the app reads them. */
+   bool idle = true;
+   for (uint32_t i = 0; i < PANVK_SUBQUEUE_COUNT; i++) {
+      if (queue->subqueues[i].kbase.emitted_jobs >
+          kbase_subqueue_seqno_cell(queue, i)->seqno)
+         idle = false;
+   }
+   kbase_kmod_csf_sync_shadows(dev->kmod.dev, idle);
+
    return VK_SUCCESS;
 }
 
