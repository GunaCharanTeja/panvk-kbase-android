+/* Lazy vertex/tiler waits (PANVK_LAZY_VTWAIT=1).
+ *
+ * vkd3d-proton transitions render targets to shader-read states with
+ * pre-rasterization shader stages in the destination scope (D3D12
+ * NON_PIXEL_SHADER_RESOURCE), so after nearly every pass the vertex/tiler
+ * subqueue waits for the fragment subqueue to go idle and the next pass
+ * cannot be tiled while the previous one is shaded (RDR1: ~2300 waits/s,
+ * the fragment subqueue idle a third of the time).
+ *
+ * When the fragment-side writes in the source scope are attachment writes
+ * only, and the vertex/tiler side of the destination scope only reads, the
+ * only vertex/tiler work that can observe those writes is a pre-raster
+ * shader sampling or loading an image (attachments are images; memory
+ * aliasing between an attachment and a buffer is not covered).  The wait
+ * is then recorded instead of emitted (the fragment subqueue still
+ * signals), and emitted before the next draw whose pre-raster shaders
+ * access images, before events, meta operations and secondary execution,
+ * and at the end of the command buffer.  Transfer and query work never
+ * runs on the vertex/tiler subqueue, so it cannot observe those writes.
+ * A later barrier that makes another subqueue wait for vertex/tiler work
+ * makes it wait for the recorded fragment point as well, so execution
+ * dependency chains through the vertex/tiler stages still hold.
+ *
+ * PANVK_LAZY_VTWAIT_FILE=<path>: enabled only while that file exists
+ * (checked once a second), for same-session A/B runs. */
+static bool
+lazy_vt_enabled(void)
+{
+   static int enabled = -1;
+   static const char *toggle;
+   static int64_t last_check;
+   static bool on;
+   if (enabled < 0) {
+      enabled = debug_get_bool_option("PANVK_LAZY_VTWAIT", false);
+      toggle = debug_get_option("PANVK_LAZY_VTWAIT_FILE", "");
+   }
+   if (!toggle[0])
+      return enabled;
+   const int64_t now = os_time_get_nano();
+   if (now - p_atomic_read(&last_check) > 1000000000ll) {
+      p_atomic_set(&last_check, now);
+      on = access(toggle, F_OK) == 0;
+   }
+   return on;
+}
+
+/* VkAccessFlagBits2 values are const variables, not constant expressions. */
+#define lazy_vt_read_access                                                    \
+  (VK_ACCESS_2_INDIRECT_COMMAND_READ_BIT | VK_ACCESS_2_INDEX_READ_BIT | \
+   VK_ACCESS_2_VERTEX_ATTRIBUTE_READ_BIT | VK_ACCESS_2_UNIFORM_READ_BIT | \
+   VK_ACCESS_2_INPUT_ATTACHMENT_READ_BIT | VK_ACCESS_2_SHADER_READ_BIT | \
+   VK_ACCESS_2_COLOR_ATTACHMENT_READ_BIT | \
+   VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_READ_BIT | \
+   VK_ACCESS_2_TRANSFER_READ_BIT | VK_ACCESS_2_HOST_READ_BIT | \
+   VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_SHADER_SAMPLED_READ_BIT | \
+   VK_ACCESS_2_SHADER_STORAGE_READ_BIT | \
+   VK_ACCESS_2_SHADER_BINDING_TABLE_READ_BIT_KHR | \
+   VK_ACCESS_2_DESCRIPTOR_BUFFER_READ_BIT_EXT | \
+   VK_ACCESS_2_ACCELERATION_STRUCTURE_READ_BIT_KHR | \
+   VK_ACCESS_2_TRANSFORM_FEEDBACK_COUNTER_READ_BIT_EXT | \
+   VK_ACCESS_2_CONDITIONAL_RENDERING_READ_BIT_EXT | \
+   VK_ACCESS_2_FRAGMENT_SHADING_RATE_ATTACHMENT_READ_BIT_KHR | \
+   VK_ACCESS_2_COMMAND_PREPROCESS_READ_BIT_EXT | \
+   VK_ACCESS_2_MICROMAP_READ_BIT_EXT)
