+/* A deferred vertex/tiler wait on the fragment subqueue (see lazy_vt in
+ * panvk_vX_cmd_buffer.c) must be emitted before a draw whose pre-raster
+ * work may read images.  Only plain vertex-shader draws whose shader
+ * variants never sample or load images skip it. */
+static bool
+lazy_vt_draw_needs_wait(const struct panvk_cmd_buffer *cmdbuf,
+                        const struct panvk_draw_info *draw)
+{
+   const struct panvk_shader *vs = cmdbuf->state.gfx.vs.shader;
+
+   if (!vs || draw->prim == MESA_PRIM_PATCHES || draw->gpu_prerast_generated ||
+       cmdbuf->state.gfx.gs.shader || cmdbuf->state.gfx.tcs.shader ||
+       cmdbuf->state.gfx.tes.shader)
+      return true;
+
+   for (unsigned v = 0; v < panvk_shader_num_variants(MESA_SHADER_VERTEX); v++) {
+      if (vs->variants[v].reads_images)
+         return true;
+   }
+   return gpu_prerast_wanted(cmdbuf, draw);
+}
