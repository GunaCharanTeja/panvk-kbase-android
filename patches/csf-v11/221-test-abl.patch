+/* TEST ONLY: PANVK_ABL bitmask for cost measurements: 1 skip draws into
+ * targets above 2 Mpx, 2 skip draws into targets below 720p, 4 skip all
+ * draws, 8 no fragment shaders. */
+static inline unsigned
+panvk_abl(void)
+{
+   /* PANVK_ABL_FILE=<path>: the mask is read from that file once a second
+    * (missing file: 0), for same-session measurements. */
+   static int v = -1;
+   static const char *path;
+   static int64_t last;
+   if (v < 0) {
+      v = debug_get_num_option("PANVK_ABL", 0);
+      path = debug_get_option("PANVK_ABL_FILE", "");
+   }
+   if (!path[0])
+      return v;
+   const int64_t now = os_time_get_nano();
+   if (now - last > 1000000000ll) {
+      last = now;
+      int r = 0;
+      FILE *f = fopen(path, "r");
+      if (f) {
+         if (fscanf(f, "%d", &r) != 1)
+            r = 0;
+         fclose(f);
+      }
+      v = r;
+   }
+   return v;
+}
+
 static inline bool
 fs_required(const struct panvk_cmd_graphics_state *state,
             const struct vk_dynamic_graphics_state *dyn_state)
 {
+   if (panvk_abl() & 8)
+      return false;
+
    const struct panvk_shader_variant *fs =
       panvk_shader_only_variant(state->fs.shader);
    const struct pan_shader_info *fs_info = fs ? &fs->info : NULL;
