+bool
+panvk_per_arch(abl_skip)(const struct panvk_cmd_buffer *cmdbuf)
+{
+   const unsigned m = panvk_abl();
+   if (!m)
+      return false;
+   if (m & 4)
+      return true;
+   const struct pan_fb_layout *fb = &cmdbuf->state.gfx.render.fb.layout;
+   const uint64_t area = (uint64_t)fb->width_px * fb->height_px;
+   return ((m & 1) && area > 2000000) || ((m & 2) && area && area < 921600);
+}
+
 static void
 panvk_cmd_draw(struct panvk_cmd_buffer *cmdbuf, struct panvk_draw_info draw)
 {
+   if (panvk_per_arch(abl_skip)(cmdbuf))
+      return;
    const struct panvk_shader_variant *vs =
       raster_vs_variant(cmdbuf, draw.gpu_prerast_generated);
    VkResult result;
