diff --git a/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c b/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c
index 8a142639..f4a422c1 100644
--- a/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c
@@ -583,6 +583,30 @@ collect_cache_flush_info(enum panvk_subqueue_id subqueue,
  *
  * PANVK_LAZY_VTWAIT_FILE / PANVK_LAZY_CWAIT_FILE=<path>: enabled only while
  * that file exists (checked once a second), for same-session A/B runs. */
+/* PANVK_KBASE_BARRIER_CSG=1 (or _FILE present): signal inter-subqueue
+ * barrier syncs with CSG scope instead of SYSTEM scope, so they don't
+ * raise a host interrupt.  Experimental. */
+static bool
+barrier_csg_scope(void)
+{
+   static int enabled = -1;
+   static const char *toggle;
+   static int64_t last_check;
+   static bool on;
+   if (enabled < 0) {
+      enabled = debug_get_bool_option("PANVK_KBASE_BARRIER_CSG", false);
+      toggle = debug_get_option("PANVK_KBASE_BARRIER_CSG_FILE", "");
+   }
+   if (!toggle[0])
+      return enabled;
+   const int64_t now = os_time_get_nano();
+   if (now - p_atomic_read(&last_check) > 1000000000ll) {
+      p_atomic_set(&last_check, now);
+      on = access(toggle, F_OK) == 0;
+   }
+   return on;
+}
+
 static bool
 lazy_vt_enabled(void)
 {
@@ -1200,8 +1224,9 @@ emit_barrier_csf(struct panvk_cmd_buffer *cmdbuf, struct panvk_cs_deps deps)
          cs_add_imm64(b, sync_addr, sync_addr,
                       sizeof(struct panvk_cs_sync64) * i);
          cs_move64_to(b, add_val, 1);
-         panvk_instr_sync64_add(cmdbuf, i, true, MALI_CS_SYNC_SCOPE_CSG,
-                                add_val, sync_addr, cs_now());
+         panvk_instr_sync64_add_scope(cmdbuf, i, true, MALI_CS_SYNC_SCOPE_CSG,
+                                      !barrier_csg_scope(), add_val,
+                                      sync_addr, cs_now());
          ++cs_state->relative_sync_point;
       }
    }
