          o += snprintf(rbuf + o, sizeof(rbuf) - o, " %s:%u", rpm_name[i], v);
    }
    mesa_logi("rpmerge:%s", o ? rbuf : " (none)");
+   panvk_per_arch(barrier_stats_log)();
 }
 
