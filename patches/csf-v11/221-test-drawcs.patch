+static void panvk_cmd_draw_impl(struct panvk_cmd_buffer *cmdbuf,
+                                struct panvk_draw_info draw);
+
+/* TEST: per-draw CS instruction counts (bytes on the VT/F/C streams),
+ * primaries vs secondaries, logged with PANVK_PASS_STATS. */
+static uint64_t dcs_bytes[2][PANVK_SUBQUEUE_COUNT], dcs_draws[2];
+
+static void
+dcs_log(void)
+{
+   for (unsigned l = 0; l < 2; l++) {
+      uint64_t n = p_atomic_xchg(&dcs_draws[l], 0);
+      uint64_t v = p_atomic_xchg(&dcs_bytes[l][0], 0);
+      uint64_t f = p_atomic_xchg(&dcs_bytes[l][1], 0);
+      uint64_t c = p_atomic_xchg(&dcs_bytes[l][2], 0);
+      if (n)
+         mesa_logi("drawcs: %s draws %" PRIu64 " VT B/draw %.0f F %.0f C %.0f",
+                   l ? "secondary" : "primary", n, (double)v / n,
+                   (double)f / n, (double)c / n);
+   }
+}
+
 static void
 panvk_cmd_draw(struct panvk_cmd_buffer *cmdbuf, struct panvk_draw_info draw)
+{
+   if (!pass_stats_enabled() || draw.gpu_prerast_generated) {
+      panvk_cmd_draw_impl(cmdbuf, draw);
+      return;
+   }
+   uint32_t pos[PANVK_SUBQUEUE_COUNT];
+   for (unsigned i = 0; i < PANVK_SUBQUEUE_COUNT; i++)
+      pos[i] = panvk_get_cs_builder(cmdbuf, i)->cur_chunk.pos;
+   panvk_cmd_draw_impl(cmdbuf, draw);
+   const unsigned l = cmdbuf->vk.level == VK_COMMAND_BUFFER_LEVEL_SECONDARY;
+   for (unsigned i = 0; i < PANVK_SUBQUEUE_COUNT; i++) {
+      uint32_t now = panvk_get_cs_builder(cmdbuf, i)->cur_chunk.pos;
+      if (now >= pos[i])
+         p_atomic_add(&dcs_bytes[l][i], now - pos[i]);
+   }
+   p_atomic_inc(&dcs_draws[l]);
+}
