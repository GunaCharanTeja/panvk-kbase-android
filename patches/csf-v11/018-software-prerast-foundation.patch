diff --git a/src/panfrost/vulkan/panvk_sw_prerast.h b/src/panfrost/vulkan/panvk_sw_prerast.h
new file mode 100644
--- /dev/null
+++ b/src/panfrost/vulkan/panvk_sw_prerast.h
@@ -0,0 +1,81 @@
+/*
+ * Copyright 2026 Abhay Byte
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef PANVK_SW_PRERAST_H
+#define PANVK_SW_PRERAST_H
+
+#include "compiler/pan_compiler.h"
+#include "panvk_macros.h"
+#include "panvk_mempool.h"
+
+struct panvk_cmd_buffer;
+struct panvk_draw_info;
+
+enum panvk_prerast_path {
+   PANVK_PRERAST_HW_IDVS,
+   PANVK_PRERAST_SW,
+};
+
+enum panvk_sw_prerast_requirement {
+   PANVK_SW_PRERAST_CLIP_DISTANCE = BITFIELD_BIT(0),
+   PANVK_SW_PRERAST_CULL_DISTANCE = BITFIELD_BIT(1),
+   PANVK_SW_PRERAST_NON_SOLID = BITFIELD_BIT(2),
+   PANVK_SW_PRERAST_GEOMETRY = BITFIELD_BIT(3),
+   PANVK_SW_PRERAST_MULTIVIEWPORT = BITFIELD_BIT(4),
+   PANVK_SW_PRERAST_XFB = BITFIELD_BIT(5),
+   PANVK_SW_PRERAST_TESSELLATION = BITFIELD_BIT(6),
+   PANVK_SW_PRERAST_SIDE_EFFECTS = BITFIELD_BIT(7),
+};
+
+struct panvk_sw_prerast_io {
+   uint64_t outputs_written;
+   uint8_t clip_distance_array_size;
+   uint8_t cull_distance_array_size;
+   struct pan_varying_layout varyings;
+};
+
+struct panvk_sw_prerast_shader {
+   struct panvk_sw_prerast_io io;
+   uint32_t requirements;
+};
+
+struct panvk_sw_prerast_draw {
+   uint64_t index_buffer;
+   uint64_t indirect_buffer;
+   uint64_t indirect_count_buffer;
+   uint32_t index_buffer_size;
+   uint32_t index_offset;
+   uint32_t index_size;
+   int32_t vertex_offset;
+   uint32_t vertex_count;
+   uint32_t first_instance;
+   uint32_t instance_count;
+   uint32_t draw_count;
+   uint32_t indirect_stride;
+   enum mesa_prim prim;
+   bool primitive_restart;
+};
+
+struct panvk_sw_prerast_buffers {
+   struct pan_ptr vertices;
+   struct pan_ptr indices;
+   struct pan_ptr counters;
+   struct pan_ptr indirect;
+};
+
+static inline enum panvk_prerast_path
+panvk_sw_prerast_select(uint32_t requirements)
+{
+   return requirements ? PANVK_PRERAST_SW : PANVK_PRERAST_HW_IDVS;
+}
+
+struct panvk_sw_prerast_draw
+panvk_per_arch(sw_prerast_draw_info)(const struct panvk_draw_info *draw);
+
+bool panvk_per_arch(sw_prerast_alloc)(
+   struct panvk_cmd_buffer *cmdbuf, const size_t sizes[4],
+   struct panvk_sw_prerast_buffers *buffers);
+
+#endif
