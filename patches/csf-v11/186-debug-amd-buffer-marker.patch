--- a/src/panfrost/vulkan/panvk_vX_physical_device.c
+++ b/src/panfrost/vulkan/panvk_vX_physical_device.c
@@ -157,6 +157,10 @@ panvk_per_arch(get_physical_device_extensions)(
       .EXT_depth_bias_control = true,
       .EXT_depth_clamp_control = true,
       .EXT_depth_clamp_zero_one = true,
+      /* Debug only: lets vkd3d-proton breadcrumbs (VKD3D_CONFIG=breadcrumbs)
+       * locate the command that faults the GPU. */
+      .AMD_buffer_marker = PAN_ARCH >= 10 &&
+                           debug_get_bool_option("PANVK_BUFFER_MARKER", false),
       .EXT_depth_clip_enable = true,
       .EXT_depth_clip_control = true,
       .EXT_device_address_binding_report = true,
