    if (pInfo->stageFlags & VK_SHADER_STAGE_ALL_GRAPHICS)
       panvk_per_arch(CmdSetDescriptorBufferOffsetsEXT)(
          commandBuffer, VK_PIPELINE_BIND_POINT_GRAPHICS, pInfo->layout,
