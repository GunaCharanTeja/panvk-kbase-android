diff --git a/src/panfrost/vulkan/panvk_submit_stats.h b/src/panfrost/vulkan/panvk_submit_stats.h
new file mode 100644
index 00000000..1da76289
--- /dev/null
+++ b/src/panfrost/vulkan/panvk_submit_stats.h
@@ -0,0 +1,37 @@
+/*
+ * Copyright 2026 panvk-kbase-android
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef PANVK_SUBMIT_STATS_H
+#define PANVK_SUBMIT_STATS_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#if defined(HAVE_PAN_KMOD_KBASE)
+struct vk_sync;
+bool panvk_kbase_sync_is_sync_file(struct vk_sync *sync);
+
+/* PANVK_SUBMIT_STATS=1: per-second log of CPU-side blocking in the kbase
+ * submit path and in host waits. */
+enum panvk_submit_stat {
+   PANVK_SSTAT_SUBMIT,       /* driver submits */
+   PANVK_SSTAT_SUBMIT_Q1,    /* ... of which on queue index 1 */
+   PANVK_SSTAT_GPU_WAIT,     /* waits turned into GPU-side waits */
+   PANVK_SSTAT_XQ_WAIT,      /* CPU wait on another queue's work */
+   PANVK_SSTAT_FILE_WAIT,    /* CPU wait on an imported sync file */
+   PANVK_SSTAT_OTHER_WAIT,   /* CPU wait on anything else */
+   PANVK_SSTAT_TILER_DRAIN,  /* tiler heap backpressure wait */
+   PANVK_SSTAT_HOST_WAIT,    /* vkWaitForFences/Semaphores etc. */
+   PANVK_SSTAT_PENDING_WAIT, /* waits for a signal to be submitted */
+   PANVK_SSTAT_QUERY_WAIT,   /* vkGetQueryPoolResults WAIT_BIT */
+   PANVK_SSTAT_COUNT,
+};
+
+bool panvk_submit_stats_enabled(void);
+void panvk_submit_stats_add(enum panvk_submit_stat stat, int64_t ns);
+void panvk_submit_stats_set_in_submit(bool in_submit);
+#endif
+
+#endif
