    }
 }
 
+bool
+panvk_kbase_sync_is_sync_file(struct vk_sync *sync)
+{
+   if (sync->type->wait_many != kbase_cpu_sync_wait_many)
+      return false;
+
+   struct kbase_cpu_sync *ks = container_of(sync, struct kbase_cpu_sync, sync);
+   mtx_lock(&ks->mutex);
+   bool file = ks->pending_wait == kbase_sync_file_wait_func;
+   mtx_unlock(&ks->mutex);
+   return file;
+}
