+static struct {
+   simple_mtx_t lock;
+   int64_t start_ns;
+   uint32_t count[PANVK_SSTAT_COUNT];
+   int64_t ns[PANVK_SSTAT_COUNT];
+} sstat = { .lock = SIMPLE_MTX_INITIALIZER };
+
+static __thread bool sstat_in_submit;
+
+bool
+panvk_submit_stats_enabled(void)
+{
+   static int enabled = -1;
+   if (enabled < 0)
+      enabled = debug_get_bool_option("PANVK_SUBMIT_STATS", false);
+   return enabled;
+}
+
+void
+panvk_submit_stats_add(enum panvk_submit_stat stat, int64_t ns)
+{
+   static const char *names[PANVK_SSTAT_COUNT] = {
+      "submit", "q1", "gpuwait", "xq", "file", "other", "tiler", "host",
+      "pend", "query",
+   };
+
+   simple_mtx_lock(&sstat.lock);
+   const int64_t now = os_time_get_nano();
+   if (!sstat.start_ns)
+      sstat.start_ns = now;
+   sstat.count[stat]++;
+   sstat.ns[stat] += ns;
+
+   if (now - sstat.start_ns >= 1000000000ll) {
+      char buf[512];
+      int len = 0;
+      for (unsigned i = 0; i < PANVK_SSTAT_COUNT; i++)
+         len += snprintf(buf + len, sizeof(buf) - len, " %s %u/%.1fms",
+                         names[i], sstat.count[i], sstat.ns[i] / 1e6);
+      mesa_logi("panvk sstat %.2fs:%s", (now - sstat.start_ns) / 1e9, buf);
+      memset(sstat.count, 0, sizeof(sstat.count));
+      memset(sstat.ns, 0, sizeof(sstat.ns));
+      sstat.start_ns = now;
+   }
+   simple_mtx_unlock(&sstat.lock);
+}
+
+static VkResult
+kbase_cpu_sync_wait_many(struct vk_device *device,
+                         uint32_t wait_count, const struct vk_sync_wait *waits,
+                         enum vk_sync_wait_flags wait_flags,
+                         uint64_t abs_timeout_ns)
+{
+   if (!panvk_submit_stats_enabled() || sstat_in_submit || !abs_timeout_ns)
+      return kbase_cpu_sync_wait_many_impl(device, wait_count, waits,
+                                           wait_flags, abs_timeout_ns);
+
+   const int64_t t0 = os_time_get_nano();
+   VkResult result = kbase_cpu_sync_wait_many_impl(
+      device, wait_count, waits, wait_flags, abs_timeout_ns);
+   panvk_submit_stats_add((wait_flags & VK_SYNC_WAIT_PENDING)
+                             ? PANVK_SSTAT_PENDING_WAIT
+                             : PANVK_SSTAT_HOST_WAIT,
+                          os_time_get_nano() - t0);
+   return result;
+}
+
+void
+panvk_submit_stats_set_in_submit(bool in_submit)
+{
+   sstat_in_submit = in_submit;
+}
