-            lerped = mix(ep0, ep1, (1.0 / 3.0) * float(bits - 1));
-        res = vec4(lerped, 1.0);
-    }
-    else
-    {
-        if (bits == 3)
-        {
-            res = vec4(0);
-        }
-        else
-        {
-            if (bits == 0)
-                lerped = ep0;
-            else if (bits == 1)
-                lerped = ep1;
-            else
-                lerped = 0.5 * (ep0 + ep1);
-            res = vec4(lerped, 1.0);
-        }
-    }
