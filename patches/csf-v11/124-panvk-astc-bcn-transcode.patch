+uvec4 pack_astc_4x4_block(uvec4 eps[2], uint weights[16], bool use_alpha) {
+    uvec4 final_block = uvec4(0u, 0u, 0u, 0u);
+
+    const uint quant_weight_mode = 8u;
+    uint num_endpoints = use_alpha ? 8u : 6u;
+    uint cem = use_alpha ? 12u : 8u;
+    uint ep_bits = use_alpha ? 4u : 6u;
+
+    const uint a = 2u;
+    const uint b = 0u;
+    const uint d = 0u;
+    const uint h = 1u;
+    const uint r = 4u;
+
+    const uint block_mode = ((r >> 1u) & 0x3u) | ((r & 0x1u) << 4u) |
+                            ((a & 0x3u) << 5u) | ((b & 0x3u) << 7u) | (h << 9u) |
+                            (d << 10u);
+
+    final_block.x = (block_mode & 0x7FFu) | ((cem & 0xFu) << 13u);
+    uint fwd_offset = 17u;
+
+    uint w_max = WEIGHT_MAX_VALUES[quant_weight_mode];
+    uint w_max_scaled = ((w_max << 16u) + 127u) / 255u;
+    for (uint i = 0u; i < 16u; ++i) {
+        uint q_w = (weights[i] * w_max_scaled + 32768u) >> 16u;
+        q_w = clamp(q_w, 0u, w_max);
+        uint rev4 = bitfieldReverse(q_w) >> 28u;
+        if (i < 8u) {
+            final_block.w |= (rev4 << (28u - 4u * i));
+        } else {
+            final_block.z |= (rev4 << (28u - 4u * (i - 8u)));
+        }
+    }
+
+    uint ep_max = use_alpha ? ENDPOINT_MAX_VALUES[13] : ENDPOINT_MAX_VALUES[19];
+    uint ep_max_scaled = ((ep_max << 16u) + 127u) / 255u;
+    uint unscrambler_offset = use_alpha ? 0u : 48u;
+
+    uint quantized_endpoints[8];
+    for (uint i = 0u; i < num_endpoints; ++i) {
+        uint raw_endpoint;
+        uint ep_idx = i & 1u;
+        uint comp_idx = i >> 1u;
+        if (comp_idx == 0u) raw_endpoint = eps[ep_idx].r;
+        else if (comp_idx == 1u) raw_endpoint = eps[ep_idx].g;
+        else if (comp_idx == 2u) raw_endpoint = eps[ep_idx].b;
+        else raw_endpoint = eps[ep_idx].a;
+
+        uint q_ep = (raw_endpoint * ep_max_scaled + 32768u) >> 16u;
+        q_ep = clamp(q_ep, 0u, ep_max);
+        quantized_endpoints[i] = packed_unscrambler_data[q_ep + unscrambler_offset];
+    }
+
+    encode_trits(final_block.x, final_block.y, fwd_offset, quantized_endpoints, ep_bits, num_endpoints);
+
+    return final_block;
+}
+
+void solve_weights(vec4 ep0, vec4 ep1, vec4 pixels[16], out uint weights[16]) {
+    vec4 L = ep1 - ep0;
+    float invLenSq = 1.0 / (dot(L, L) + 0.000001);
+    for (int i = 0; i < 16; i++) {
+        vec4 C = pixels[i];
+        float pDotL = dot(C - ep0, L);
+        float w = clamp(pDotL * invLenSq, 0.0, 1.0);
+        weights[i] = uint(w * 255.0 + 0.5);
+    }
+}
+
+void encode_block_AABB(vec4 pixels[16], out uvec4 endpoint_start, out uvec4 endpoint_end,
+                       out uint weights[16], out bool use_alpha) {
+    vec4 min_p = pixels[0];
+    vec4 max_p = pixels[0];
+    use_alpha = false;
+
+    for (int i = 0; i < 16; i++) {
+        min_p = min(min_p, pixels[i]);
+        max_p = max(max_p, pixels[i]);
+        if (pixels[i].a < 0.999)
+            use_alpha = true;
+    }
+
+    endpoint_start = uvec4(clamp(min_p * 255.0 + 0.5, 0.0, 255.0));
+    endpoint_end = uvec4(clamp(max_p * 255.0 + 0.5, 0.0, 255.0));
+
+    solve_weights(min_p, max_p, pixels, weights);
+}
