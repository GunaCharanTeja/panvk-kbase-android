+
+    const uint block_mode = ((r >> 1u) & 0x3u) | ((r & 0x1u) << 4u) |
+                            ((a & 0x3u) << 5u) | ((b & 0x3u) << 7u) | (h << 9u) |
+                            (d << 10u);
+
+    final_block.x = (block_mode & 0x7FFu) | ((cem & 0xFu) << 13u);
+    uint fwd_offset = 17u;
+
+    uint w_max = WEIGHT_MAX_VALUES[quant_weight_mode];
+    uint w_max_scaled = ((w_max << 16u) + 127u) / 255u;
+    for (uint i = 0u; i < 16u; ++i) {
+        uint q_w = (weights[i] * w_max_scaled + 32768u) >> 16u;
+        q_w = clamp(q_w, 0u, w_max);
+        uint rev4 = bitfieldReverse(q_w) >> 28u;
+        if (i < 8u) {
+            final_block.w |= (rev4 << (28u - 4u * i));
+        } else {
+            final_block.z |= (rev4 << (28u - 4u * (i - 8u)));
+        }
+    }
+
+    uint ep_max = use_alpha ? ENDPOINT_MAX_VALUES[13] : ENDPOINT_MAX_VALUES[19];
+    uint ep_max_scaled = ((ep_max << 16u) + 127u) / 255u;
+    uint unscrambler_offset = use_alpha ? 0u : 48u;
+
+    uint quantized_endpoints[8];
+    for (uint i = 0u; i < num_endpoints; ++i) {
+        uint raw_endpoint;
+        uint ep_idx = i & 1u;
+        uint comp_idx = i >> 1u;
+        if (comp_idx == 0u) raw_endpoint = eps[ep_idx].r;
+        else if (comp_idx == 1u) raw_endpoint = eps[ep_idx].g;
+        else if (comp_idx == 2u) raw_endpoint = eps[ep_idx].b;
+        else raw_endpoint = eps[ep_idx].a;
+
+        uint q_ep = (raw_endpoint * ep_max_scaled + 32768u) >> 16u;
+        q_ep = clamp(q_ep, 0u, ep_max);
+        quantized_endpoints[i] = packed_unscrambler_data[q_ep + unscrambler_offset];
+    }
+
+    encode_trits(final_block.x, final_block.y, fwd_offset, quantized_endpoints, ep_bits, num_endpoints);
+
+    return final_block;
+}
+
+void solve_weights(vec4 ep0, vec4 ep1, vec4 pixels[16], out uint weights[16]) {
+    vec4 L = ep1 - ep0;
+    float invLenSq = 1.0 / (dot(L, L) + 0.000001);
+    for (int i = 0; i < 16; i++) {
+        vec4 C = pixels[i];
+        float pDotL = dot(C - ep0, L);
+        float w = clamp(pDotL * invLenSq, 0.0, 1.0);
+        weights[i] = uint(w * 255.0 + 0.5);
+    }
+}
+
+void encode_block_AABB(vec4 pixels[16], out uvec4 endpoint_start, out uvec4 endpoint_end,
+                       out uint weights[16], out bool use_alpha) {
+    vec4 min_p = pixels[0];
+    vec4 max_p = pixels[0];
+    use_alpha = false;
+
+    for (int i = 0; i < 16; i++) {
+        min_p = min(min_p, pixels[i]);
+        max_p = max(max_p, pixels[i]);
+        if (pixels[i].a < 0.999)
+            use_alpha = true;
+    }
+
+    endpoint_start = uvec4(clamp(min_p * 255.0 + 0.5, 0.0, 255.0));
+    endpoint_end = uvec4(clamp(max_p * 255.0 + 0.5, 0.0, 255.0));
+
+    solve_weights(min_p, max_p, pixels, weights);
+}
+
+
+void main()
+{
+    uint bx = gl_GlobalInvocationID.x;
+    uint by = gl_GlobalInvocationID.y;
+    uint bz = gl_GlobalInvocationID.z;
+
+    uint num_blocks_x = uint((registers.width + 3) / 4);
+    uint num_blocks_y = uint((registers.height + 3) / 4);
+
+    if (bx >= num_blocks_x || by >= num_blocks_y || bz >= uint(registers.depth))
+        return;
+
+    InBuf ibuf = InBuf(registers.src);
+    OutBuf obuf = OutBuf(registers.dst);
+
+    uint in_word = (bz * registers.src_slice_B + by * registers.src_row_B) / 4u + bx * 4u;
+    uint out_word = (bz * registers.dst_slice_B + by * registers.dst_row_B) / 4u + bx * 4u;
+
+    uvec4 payload = uvec4(ibuf.data[in_word], ibuf.data[in_word + 1u], ibuf.data[in_word + 2u], ibuf.data[in_word + 3u]);
+    int mode = findLSB(payload.x);
+
+    vec4 pixels[16];
+    for (int p = 0; p < 16; p++) {
+        DecodedInterpolation interp;
+        switch (mode) {
+            case 0: interp = decode_bc7_mode0(payload, p); break;
+            case 1: interp = decode_bc7_mode1(payload, p); break;
+            case 2: interp = decode_bc7_mode2(payload, p); break;
+            case 3: interp = decode_bc7_mode3(payload, p); break;
+            case 4: interp = decode_bc7_mode4(payload, p); break;
+            case 5: interp = decode_bc7_mode5(payload, p); break;
+            case 6: interp = decode_bc7_mode6(payload, p); break;
+            case 7: interp = decode_bc7_mode7(payload, p); break;
+            default: interp = DecodedInterpolation(uvec4(0), uvec4(0), 0, 0, 0); break;
+        }
+        uvec4 rgba_result = interpolate_endpoint(interp);
+        pixels[p] = rgba_result / 255.0;
+    }
+
+    uvec4 astc_ep0, astc_ep1;
+    uint weights[16];
+    bool use_alpha;
+    encode_block_AABB(pixels, astc_ep0, astc_ep1, weights, use_alpha);
+    uvec4 eps[2] = uvec4[2](astc_ep0, astc_ep1);
+    uvec4 astc = pack_astc_4x4_block(eps, weights, use_alpha);
+
+    obuf.data[out_word + 0u] = astc.x;
+    obuf.data[out_word + 1u] = astc.y;
+    obuf.data[out_word + 2u] = astc.z;
+    obuf.data[out_word + 3u] = astc.w;
+}
