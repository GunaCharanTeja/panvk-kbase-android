+void write_bits_fwd(inout uint block_x, inout uint block_y,
+                    inout uint bit_offset, uint value, uint count) {
+    uint clean_value = value & ((1u << count) - 1u);
+    uint bit_idx = bit_offset & 31u;
+    uint val0 = clean_value << bit_idx;
+    bool does_overflow = (bit_idx + count > 32u);
+    uint val1 = does_overflow ? (clean_value >> ((32u - bit_idx) & 31u)) : 0u;
+
+    uint word_idx = bit_offset >> 5u;
+    if (word_idx == 0u) {
+        block_x |= val0;
+        block_y |= val1;
+    } else if (word_idx == 1u) {
+        block_y |= val0;
+    }
+
+    bit_offset += count;
+}
+
+void encode_trits(inout uint block_x, inout uint block_y, inout uint bit_offset,
+                  uint numbers[8], uint bits, uint count) {
+    for (uint i = 0u; i < count; i += 5u) {
+        uint group[5] = uint[5](0u, 0u, 0u, 0u, 0u);
+        for (uint j = 0u; j < 5u; ++j) {
+            if (i + j < count)
+                group[j] = numbers[i + j];
+        }
+        uint m[5], t[5];
+        uint mask = (1u << bits) - 1u;
+        for (uint j = 0u; j < 5u; ++j) {
+            m[j] = group[j] & mask;
+            t[j] = group[j] >> bits;
+        }
+
+        uint index = t[4] * 81u + t[3] * 27u + t[2] * 9u + t[1] * 3u + t[0];
+        uint packhigh = packed_trit_data[index];
+        write_bits_fwd(block_x, block_y, bit_offset, m[0], bits);
+        write_bits_fwd(block_x, block_y, bit_offset, packhigh & 3u, 2u);
+        write_bits_fwd(block_x, block_y, bit_offset, m[1], bits);
+        write_bits_fwd(block_x, block_y, bit_offset, (packhigh >> 2u) & 3u, 2u);
+        write_bits_fwd(block_x, block_y, bit_offset, m[2], bits);
+        write_bits_fwd(block_x, block_y, bit_offset, (packhigh >> 4u) & 1u, 1u);
+        write_bits_fwd(block_x, block_y, bit_offset, m[3], bits);
+        write_bits_fwd(block_x, block_y, bit_offset, (packhigh >> 5u) & 3u, 2u);
+        write_bits_fwd(block_x, block_y, bit_offset, m[4], bits);
+        write_bits_fwd(block_x, block_y, bit_offset, (packhigh >> 7u) & 1u, 1u);
+    }
+}
