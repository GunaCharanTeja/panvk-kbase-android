+/* Quantise an endpoint (0..255); returns the ISE value, unq the decoded value. */
+uint ep_quant(uint er, float v, out float unq)
+{
+   v = clamp(v, 0.0, 255.0);
+   if (er == ER_255) {
+      uint r = uint(v + 0.5);
+      unq = float(r);
+      return r;
+   }
+   if (er == ER_63) {
+      uint best = 0u;
+      float be = 1e9;
+      int r0 = int(v * 63.0 / 255.0 + 0.5);
+      for (int r = max(r0 - 1, 0); r <= min(r0 + 1, 63); r++) {
+         float u = float((uint(r) << 2u) | (uint(r) >> 4u));
+         if (abs(u - v) < be) { be = abs(u - v); best = uint(r); unq = u; }
+      }
+      return best;
+   }
+   const int maxr = er == ER_47 ? 47 : 191;
+   int r0 = int(v * float(maxr) / 255.0 + 0.5);
+   uint best = 0u;
+   float be = 1e9;
+   for (int r = max(r0 - 1, 0); r <= min(r0 + 1, maxr); r++) {
+      float u = float(er == ER_47 ? E47_UNQ[r] : E191_UNQ[r]);
+      if (abs(u - v) < be) { be = abs(u - v); best = uint(r); unq = u; }
+   }
+   return er == ER_47 ? E47_ISE[best] : E191_ISE[best];
+}
+
+/* Nearest weight level for t in [0, 1]; returns the level index. */
+uint wt_level(uint wr, float t)
+{
+   float x = clamp(t, 0.0, 1.0) * 64.0;
+   uint best = 0u;
+   float be = 1e9;
+   for (uint k = 0u; k < WR_N[wr]; k++) {
+      float e = abs(float(WT_UNQ[wr * 32u + k]) - x);
+      if (e < be) { be = e; best = k; }
+   }
+   return best;
+}
