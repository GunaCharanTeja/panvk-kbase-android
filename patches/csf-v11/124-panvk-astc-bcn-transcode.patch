+float decode_alpha_rgtc(uvec2 payload, int linear_pixel)
+{
+	float ep0 = float(int(payload.x & 0xffu)) / 255.0;
+	float ep1 = float(((payload.x >> 8) & 0xffu)) / 255.0;
+	bool range7 = ep0 > ep1;
+
+	int bit_offset = 16 + linear_pixel * 3;
+	uint bits;
+	if (bit_offset <= 29)
+		bits = bitfieldExtract(payload.x, bit_offset, 3);
+	else if (bit_offset >= 32)
+		bits = bitfieldExtract(payload.y, bit_offset - 32, 3);
+	else
+		bits = bitfieldExtract(payload.x, 31, 1) | ((payload.y & 3) << 1);
+
+	float res;
+	if (bits < 2)
+		res = bits != 0 ? ep1 : ep0;
+	else if (range7)
+		res = mix(ep0, ep1, (1.0 / 7.0) * float(bits - 1));
+	else if (bits > 5)
+		res = float(bits & 1);
+	else
+		res = mix(ep0, ep1, (1.0 / 5.0) * float(bits - 1));
+
+	return res;
+}
+
+float decode_alpha_rgtc_snorm(uvec2 payload, int linear_pixel)
+{
+   float ep0 = max(float(bitfieldExtract(int(payload.x), 0, 8)) / 127.0, -1.0);
+   float ep1 = max(float(bitfieldExtract(int(payload.x), 8, 8)) / 127.0, -1.0);
+   bool range7 = ep0 > ep1;
+   int bit_offset = 16 + linear_pixel * 3;
+   uint bits = bit_offset <= 29 ? bitfieldExtract(payload.x, bit_offset, 3) :
+               bit_offset >= 32 ? bitfieldExtract(payload.y, bit_offset - 32, 3) :
+               bitfieldExtract(payload.x, 31, 1) | ((payload.y & 3) << 1);
+   if (bits < 2)
+      return bits != 0 ? ep1 : ep0;
+   if (range7)
+      return mix(ep0, ep1, (1.0 / 7.0) * float(bits - 1));
+   if (bits > 5)
+      return bits == 6 ? -1.0 : 1.0;
+   return mix(ep0, ep1, (1.0 / 5.0) * float(bits - 1));
+}
+
+vec3 decode_endpoint_color(uint color)
+{
+    ivec3 c = ivec3(color) >> ivec3(11, 5, 0);
+    c &= ivec3(31, 63, 31);
+    return vec3(c) / vec3(31.0, 63.0, 31.0);
+}
+
+bool decode_endpoints_color(int format, uint payload, out vec3 ep0, out vec3 ep1)
+{
+    uint color0 = payload & 0xffffu;
+    uint color1 = payload >> 16u;
+    bool opaque_mode = (format > VK_FORMAT_BC1_RGBA_SRGB_BLOCK) || (color0 > color1);
+    ep0 = decode_endpoint_color(color0);
+    ep1 = decode_endpoint_color(color1);
+    return opaque_mode;
+}
+
+vec4 interpolate_endpoint_color(vec3 ep0, vec3 ep1, int bits, bool opaque_mode)
+{
+    vec4 res;
+    vec3 lerped;
+    if (opaque_mode)
+    {
+        if (bits < 2)
+            lerped = bits != 0 ? ep1 : ep0;
+        else
+            lerped = mix(ep0, ep1, (1.0 / 3.0) * float(bits - 1));
+        res = vec4(lerped, 1.0);
+    }
+    else
+    {
+        if (bits == 3)
+        {
+            res = vec4(0.0);
+        }
+        else
+        {
+            if (bits == 0)
+                lerped = ep0;
+            else if (bits == 1)
+                lerped = ep1;
+            else
+                lerped = 0.5 * (ep0 + ep1);
+            res = vec4(lerped, 1.0);
+        }
+    }
+    return res;
+}
+
+float decode_alpha_4bit(uvec2 payload, int pixel)
+{
+    uint offset = pixel * 4;
+    return float((payload[offset >> 5] >> (offset & 31)) & 0xf) / 15.0;
+}
+
+void main()
+{
+    uint bx = gl_GlobalInvocationID.x;
+    uint by = gl_GlobalInvocationID.y;
+    uint bz = gl_GlobalInvocationID.z;
+
+    uint num_blocks_x = uint((registers.width + 3) / 4);
+    uint num_blocks_y = uint((registers.height + 3) / 4);
+
+    if (bx >= num_blocks_x || by >= num_blocks_y || bz >= uint(registers.depth))
+        return;
+
+    InBuf ibuf = InBuf(registers.src);
+    OutBuf obuf = OutBuf(registers.dst);
+
+    int format = registers.format;
+    uint bw = (format <= VK_FORMAT_BC1_RGBA_SRGB_BLOCK || format == VK_FORMAT_BC4_UNORM_BLOCK || format == VK_FORMAT_BC4_SNORM_BLOCK) ? 2u : 4u;
+    uint in_word = (bz * registers.src_slice_B + by * registers.src_row_B) / 4u + bx * bw;
+    uint out_word = (bz * registers.dst_slice_B + by * registers.dst_row_B) / 4u + bx * 4u;
+
+    vec4 pixels[16];
+    uvec2 color_payload, alpha_payload;
+    vec3 ep0, ep1;
+    bool opaque_mode;
+
+    if (format == VK_FORMAT_BC4_UNORM_BLOCK) {
+        uvec2 r_payload = uvec2(ibuf.data[in_word], ibuf.data[in_word + 1u]);
+        for (int p = 0; p < 16; p++) {
+            float r = decode_alpha_rgtc(r_payload, p);
+            pixels[p] = vec4(r, 0.0, 0.0, 1.0);
+        }
+    } else if (format == VK_FORMAT_BC4_SNORM_BLOCK) {
+        uvec2 r_payload = uvec2(ibuf.data[in_word], ibuf.data[in_word + 1u]);
+        for (int p = 0; p < 16; p++) {
+            float r = decode_alpha_rgtc_snorm(r_payload, p);
+            pixels[p] = vec4(clamp(r * 0.5 + 0.5, 0.0, 1.0), 0.0, 0.0, 1.0);
+        }
+    } else if (format == VK_FORMAT_BC5_UNORM_BLOCK) {
+        uvec2 r_payload = uvec2(ibuf.data[in_word], ibuf.data[in_word + 1u]);
+        uvec2 g_payload = uvec2(ibuf.data[in_word + 2u], ibuf.data[in_word + 3u]);
+        for (int p = 0; p < 16; p++) {
+            float r = decode_alpha_rgtc(r_payload, p);
+            float g = decode_alpha_rgtc(g_payload, p);
+            pixels[p] = vec4(r, g, 0.0, 1.0);
+        }
+    } else if (format == VK_FORMAT_BC5_SNORM_BLOCK) {
+        uvec2 r_payload = uvec2(ibuf.data[in_word], ibuf.data[in_word + 1u]);
+        uvec2 g_payload = uvec2(ibuf.data[in_word + 2u], ibuf.data[in_word + 3u]);
+        for (int p = 0; p < 16; p++) {
+            float r = decode_alpha_rgtc_snorm(r_payload, p);
+            float g = decode_alpha_rgtc_snorm(g_payload, p);
+            pixels[p] = vec4(clamp(r * 0.5 + 0.5, 0.0, 1.0), clamp(g * 0.5 + 0.5, 0.0, 1.0), 0.0, 1.0);
+        }
+    } else if (bw == 2u) {
+        color_payload = uvec2(ibuf.data[in_word], ibuf.data[in_word + 1u]);
+        opaque_mode = decode_endpoints_color(format, color_payload.x, ep0, ep1);
+        for (int p = 0; p < 16; p++) {
+            int bits = int((color_payload.y >> (2 * p)) & 3u);
+            pixels[p] = interpolate_endpoint_color(ep0, ep1, bits, opaque_mode);
+        }
+    } else {
+        alpha_payload = uvec2(ibuf.data[in_word], ibuf.data[in_word + 1u]);
+        color_payload = uvec2(ibuf.data[in_word + 2u], ibuf.data[in_word + 3u]);
+        opaque_mode = decode_endpoints_color(format, color_payload.x, ep0, ep1);
+        for (int p = 0; p < 16; p++) {
+            int bits = int((color_payload.y >> (2 * p)) & 3u);
+            vec4 col = interpolate_endpoint_color(ep0, ep1, bits, opaque_mode);
+            if (format <= VK_FORMAT_BC2_SRGB_BLOCK)
+                col.a = decode_alpha_4bit(alpha_payload, p);
+            else
+                col.a = decode_alpha_rgtc(alpha_payload, p);
+            pixels[p] = col;
+        }
+    }
+
+    uvec4 astc_ep0, astc_ep1;
+    uint weights[16];
+    bool use_alpha;
+    encode_block_AABB(pixels, astc_ep0, astc_ep1, weights, use_alpha);
+    uvec4 eps[2] = uvec4[2](astc_ep0, astc_ep1);
+    uvec4 astc = pack_astc_4x4_block(eps, weights, use_alpha);
+
+    obuf.data[out_word + 0u] = astc.x;
+    obuf.data[out_word + 1u] = astc.y;
+    obuf.data[out_word + 2u] = astc.z;
+    obuf.data[out_word + 3u] = astc.w;
+}
