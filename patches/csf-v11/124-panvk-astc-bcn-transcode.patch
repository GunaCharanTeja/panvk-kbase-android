+void main()
+{
+    uint bx = gl_GlobalInvocationID.x;
+    uint by = gl_GlobalInvocationID.y;
+    uint bz = gl_GlobalInvocationID.z;
+
+    uint num_blocks_x = uint((registers.width + 3) / 4);
+    uint num_blocks_y = uint((registers.height + 3) / 4);
+
+    if (bx >= num_blocks_x || by >= num_blocks_y || bz >= uint(registers.depth))
+        return;
+
+    InBuf ibuf = InBuf(registers.src);
+    OutBuf obuf = OutBuf(registers.dst);
+
+    int format = registers.format;
+    uint bw = (format <= VK_FORMAT_BC1_RGBA_SRGB_BLOCK) ? 2u : 4u;
+    uint in_word = (bz * registers.src_slice_B + by * registers.src_row_B) / 4u + bx * bw;
+    uint out_word = (bz * registers.dst_slice_B + by * registers.dst_row_B) / 4u + bx * 4u;
+
+    vec4 pixels[16];
+    uvec2 color_payload, alpha_payload;
+    vec3 ep0, ep1;
+    bool opaque_mode;
+
+    if (bw == 2u) {
+        color_payload = uvec2(ibuf.data[in_word], ibuf.data[in_word + 1u]);
+        opaque_mode = decode_endpoints_color(format, color_payload.x, ep0, ep1);
+        for (int p = 0; p < 16; p++) {
+            int bits = int((color_payload.y >> (2 * p)) & 3u);
+            pixels[p] = interpolate_endpoint_color(ep0, ep1, bits, opaque_mode);
+        }
+    } else {
+        alpha_payload = uvec2(ibuf.data[in_word], ibuf.data[in_word + 1u]);
+        color_payload = uvec2(ibuf.data[in_word + 2u], ibuf.data[in_word + 3u]);
+        opaque_mode = decode_endpoints_color(format, color_payload.x, ep0, ep1);
