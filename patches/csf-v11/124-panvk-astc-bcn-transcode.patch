+/* Colour block (BC1-3, BC7). px in 0..255 RGBA. */
+uvec4 astc_encode_rgba(vec4 px[16])
+{
+   bool opaque = true;
+   for (int i = 0; i < 16; i++)
+      opaque = opaque && px[i].a >= 254.5;
+
+   uvec4 blk, cand;
+   if (opaque) {
+      /* Alpha decodes as 255 in RGB modes; it matches. */
+      astc_encode_mode(px, 8u, 3u, false, 0u, WR_15, ER_191, blk);
+      return blk;
+   }
+   float e = astc_encode_mode(px, 12u, 4u, false, 0u, WR_15, ER_47, blk);
+   float e2 = astc_encode_mode(px, 12u, 4u, true, 3u, WR_3, ER_47, cand);
+   return e2 < e ? cand : blk;
+}
+
+/* Two independent channels (BC5): x -> luminance, y -> alpha. Sample with
+ * an (X, W, 0, 1) swizzle. */
+uvec4 astc_encode_two_channel(vec2 v[16])
+{
+   vec4 px[16];
+   for (int i = 0; i < 16; i++) {
+      /* LA decodes as (L, L, L, A); only x and w are read through the
+       * swizzle, so score just L and A (kept in .x/.y here). */
+      px[i] = vec4(v[i], 0.0, 0.0);
+   }
+   uvec4 blk, cand;
+   float e = astc_encode_mode(px, 4u, 2u, true, 1u, WR_5, ER_63, blk);
+   float e2 = astc_encode_mode(px, 4u, 2u, true, 1u, WR_4, ER_255, cand);
+   if (e2 < e) { e = e2; blk = cand; }
+   e2 = astc_encode_mode(px, 4u, 2u, false, 0u, WR_15, ER_255, cand);
+   if (e2 < e) { e = e2; blk = cand; }
+   return blk;
+}
+
+/* One channel (BC4 UNORM): luminance, 32 weight levels, exact endpoints.
+ * Sample with an (X, 0, 0, 1) swizzle. */
+uvec4 astc_encode_one_channel(float v[16])
+{
+   vec4 px[16];
+   for (int i = 0; i < 16; i++)
+      px[i] = vec4(v[i], 0.0, 0.0, 0.0);
+   uvec4 blk;
+   astc_encode_mode(px, 0u, 1u, false, 0u, WR_31, ER_255, blk);
+   return blk;
+}
+
+/* HDR ASTC (CEM 11, HDR RGB direct) for BC6H. Endpoints live in the 16-bit
+ * pseudo-logarithmic (LNS) space the decoder interpolates in; the packing
+ * below mirrors the decoder in ASTC spec C.2.14 (validated against the
+ * Mali-G615 hardware decoder). Weights: 0..11, endpoints: 8-bit raw. */
+
+const uint HDR_ABITS[8] = uint[](9u, 9u, 10u, 10u, 11u, 11u, 12u, 12u);
+const uint HDR_BBITS[8] = uint[](7u, 8u, 6u, 7u, 8u, 6u, 7u, 6u);
+const uint HDR_CBITS[8] = uint[](6u, 6u, 7u, 7u, 6u, 8u, 7u, 7u);
+const uint HDR_DBITS[8] = uint[](7u, 6u, 7u, 6u, 5u, 6u, 5u, 6u);
+
+/* fp16 bits (non-negative) -> LNS value (0..65535). */
+float fp16_to_lns(uint h)
+{
+   uint e = h >> 10u;
+   float mt = float((h & 0x3ffu) << 3u);
+   float m = mt < 1536.0 ? mt / 3.0 : (mt < 5632.0 ? (mt + 512.0) / 4.0 : (mt + 2048.0) / 5.0);
+   return float(e << 11u) + m;
+}
+
+int hdr_q(int x, uint s)
+{
+   int h = int((1u << s) >> 1u);
+   return x >= 0 ? (x + h) >> s : -((-x + h) >> s);
+}
+
+/* Decode six CEM 11 values to 12-bit endpoints (spec C.2.14). */
+void hdr_unpack(uint v[6], out ivec3 e0, out ivec3 e1)
+{
+   uint mode = ((v[1] >> 7u) & 1u) | (((v[2] >> 7u) & 1u) << 1u) | (((v[3] >> 7u) & 1u) << 2u);
+   uint maj = ((v[4] >> 7u) & 1u) | (((v[5] >> 7u) & 1u) << 1u);
+   if (maj == 3u) {
+      e0 = ivec3(int(v[0] << 4u), int(v[2] << 4u), int((v[4] & 0x7fu) << 5u));
+      e1 = ivec3(int(v[1] << 4u), int(v[3] << 4u), int((v[5] & 0x7fu) << 5u));
+      return;
+   }
+   int a = int(v[0] | ((v[1] & 0x40u) << 2u));
+   int b0 = int(v[2] & 0x3fu), b1 = int(v[3] & 0x3fu), c = int(v[1] & 0x3fu);
+   int d0 = int(v[4] & 0x1fu), d1 = int(v[5] & 0x1fu);
+   int x0 = int((v[2] >> 6u) & 1u), x1 = int((v[3] >> 6u) & 1u);
+   int x2 = int((v[4] >> 6u) & 1u), x3 = int((v[5] >> 6u) & 1u);
+   int x4 = int((v[4] >> 5u) & 1u), x5 = int((v[5] >> 5u) & 1u);
+   uint oh = 1u << mode;
+   if ((oh & 0xA4u) != 0u) a |= x0 << 9;
+   if ((oh & 0x08u) != 0u) a |= x2 << 9;
+   if ((oh & 0x50u) != 0u) { a |= x4 << 9; a |= x5 << 10; }
+   if ((oh & 0xA0u) != 0u) a |= x1 << 10;
+   if ((oh & 0xC0u) != 0u) a |= x2 << 11;
+   if ((oh & 0x04u) != 0u) c |= x1 << 6;
+   if ((oh & 0xE8u) != 0u) c |= x3 << 6;
+   if ((oh & 0x20u) != 0u) c |= x2 << 7;
+   if ((oh & 0x5Bu) != 0u) { b0 |= x0 << 6; b1 |= x1 << 6; }
+   if ((oh & 0x12u) != 0u) { b0 |= x2 << 7; b1 |= x3 << 7; }
+   if ((oh & 0xAFu) != 0u) { d0 |= x4 << 5; d1 |= x5 << 5; }
+   if ((oh & 0x05u) != 0u) { d0 |= x2 << 6; d1 |= x3 << 6; }
+   int db = int(HDR_DBITS[mode]);
+   d0 = bitfieldExtract(d0, 0, db);
+   d1 = bitfieldExtract(d1, 0, db);
+   uint s = (mode >> 1u) ^ 3u;
+   a <<= s; b0 <<= s; b1 <<= s; c <<= s; d0 <<= s; d1 <<= s;
+   ivec3 lo = clamp(ivec3(a - c, a - b0 - c - d0, a - b1 - c - d1), 0, 4095);
+   ivec3 hi = clamp(ivec3(a, a - b0, a - b1), 0, 4095);
+   if (maj == 1u) { lo = lo.grb; hi = hi.grb; }
+   if (maj == 2u) { lo = lo.bgr; hi = hi.bgr; }
+   e0 = lo;
+   e1 = hi;
+}
+
+void hdr_pack(ivec3 lo, ivec3 hi, uint mode, uint maj, out uint v[6])
+{
+   if (maj == 1u) { lo = lo.grb; hi = hi.grb; }
+   if (maj == 2u) { lo = lo.bgr; hi = hi.bgr; }
+   uint s = (mode >> 1u) ^ 3u;
+   int a = clamp(hdr_q(hi.r, s), 0, (1 << HDR_ABITS[mode]) - 1);
+   int A = a << s;
+   int bm = (1 << HDR_BBITS[mode]) - 1;
+   int b0 = clamp(hdr_q(A - hi.g, s), 0, bm);
+   int b1 = clamp(hdr_q(A - hi.b, s), 0, bm);
+   int c = clamp(hdr_q(A - lo.r, s), 0, (1 << HDR_CBITS[mode]) - 1);
+   int db = int(HDR_DBITS[mode]);
+   int dl = -(1 << (db - 1)), dh = (1 << (db - 1)) - 1;
+   int d0 = clamp(hdr_q(A - (b0 << s) - (c << s) - lo.g, s), dl, dh) & ((1 << db) - 1);
+   int d1 = clamp(hdr_q(A - (b1 << s) - (c << s) - lo.b, s), dl, dh) & ((1 << db) - 1);
+   uint oh = 1u << mode;
+   uint x0 = 0u, x1 = 0u, x2 = 0u, x3 = 0u, x4 = 0u, x5 = 0u;
+   uint ua = uint(a), uc = uint(c), ub0 = uint(b0), ub1 = uint(b1), ud0 = uint(d0), ud1 = uint(d1);
+   if ((oh & 0xA4u) != 0u) x0 = (ua >> 9u) & 1u;
+   if ((oh & 0x08u) != 0u) x2 = (ua >> 9u) & 1u;
+   if ((oh & 0x50u) != 0u) { x4 = (ua >> 9u) & 1u; x5 = (ua >> 10u) & 1u; }
+   if ((oh & 0xA0u) != 0u) x1 = (ua >> 10u) & 1u;
+   if ((oh & 0xC0u) != 0u) x2 = (ua >> 11u) & 1u;
+   if ((oh & 0x04u) != 0u) x1 = (uc >> 6u) & 1u;
+   if ((oh & 0xE8u) != 0u) x3 = (uc >> 6u) & 1u;
+   if ((oh & 0x20u) != 0u) x2 = (uc >> 7u) & 1u;
+   if ((oh & 0x5Bu) != 0u) { x0 = (ub0 >> 6u) & 1u; x1 = (ub1 >> 6u) & 1u; }
+   if ((oh & 0x12u) != 0u) { x2 = (ub0 >> 7u) & 1u; x3 = (ub1 >> 7u) & 1u; }
+   if ((oh & 0xAFu) != 0u) { x4 = (ud0 >> 5u) & 1u; x5 = (ud1 >> 5u) & 1u; }
+   if ((oh & 0x05u) != 0u) { x2 = (ud0 >> 6u) & 1u; x3 = (ud1 >> 6u) & 1u; }
+   v[0] = ua & 0xffu;
+   v[1] = (uc & 0x3fu) | (((ua >> 8u) & 1u) << 6u) | ((mode & 1u) << 7u);
+   v[2] = (ub0 & 0x3fu) | (x0 << 6u) | (((mode >> 1u) & 1u) << 7u);
+   v[3] = (ub1 & 0x3fu) | (x1 << 6u) | (((mode >> 2u) & 1u) << 7u);
+   v[4] = (ud0 & 0x1fu) | (x4 << 5u) | (x2 << 6u) | ((maj & 1u) << 7u);
+   v[5] = (ud1 & 0x1fu) | (x5 << 5u) | (x3 << 6u) | (((maj >> 1u) & 1u) << 7u);
+}
+
+/* Best CEM 11 encoding of 12-bit endpoints e0/e1 (either order). Returns
+ * the decoded endpoints actually stored, in 16-bit LNS units. */
+void hdr_quant_endpoints(vec3 e0, vec3 e1, out uint best_v[6], out vec3 q0, out vec3 q1)
+{
+   ivec3 i0 = clamp(ivec3(e0 / 16.0 + 0.5), 0, 4095);
+   ivec3 i1 = clamp(ivec3(e1 / 16.0 + 0.5), 0, 4095);
+   /* The decoder's second endpoint holds the overall largest component. */
+   int m0 = max(i0.r, max(i0.g, i0.b)), m1 = max(i1.r, max(i1.g, i1.b));
+   ivec3 lo = m1 >= m0 ? i0 : i1, hi = m1 >= m0 ? i1 : i0;
+   uint maj = hi.r >= hi.g && hi.r >= hi.b ? 0u : (hi.g >= hi.b ? 1u : 2u);
+
+   float be = 1e30;
+   for (uint mode = 0u; mode < 9u; mode++) {
+      uint v[6];
+      if (mode == 8u) {
+         /* Direct: 8 bits for red/green, 7 for blue, no range limits. */
+         ivec3 l8 = clamp((lo + ivec3(8, 8, 16)) >> ivec3(4, 4, 5), ivec3(0), ivec3(255, 255, 127));
+         ivec3 h8 = clamp((hi + ivec3(8, 8, 16)) >> ivec3(4, 4, 5), ivec3(0), ivec3(255, 255, 127));
+         v = uint[6](uint(l8.r), uint(h8.r), uint(l8.g), uint(h8.g),
+                     uint(l8.b) | 0x80u, uint(h8.b) | 0x80u);
+      } else {
+         hdr_pack(lo, hi, mode, maj, v);
+      }
+      ivec3 d0, d1;
+      hdr_unpack(v, d0, d1);
+      vec3 dl = vec3(d0 - lo), dh = vec3(d1 - hi);
+      float e = dot(dl, dl) + dot(dh, dh);
+      if (e < be) {
+         be = e;
+         best_v = v;
+         q0 = vec3(d0) * 16.0;
+         q1 = vec3(d1) * 16.0;
+      }
+   }
+}
+
+/* Encode 16 texels given as LNS values. */
+uvec4 astc_encode_hdr(vec3 px[16])
+{
+   vec4 p4[16];
+   vec4 mean = vec4(0.0);
+   for (int i = 0; i < 16; i++) {
+      p4[i] = vec4(px[i], 0.0);
+      mean += p4[i];
+   }
+   mean /= 16.0;
+   const vec4 mask = vec4(1.0, 1.0, 1.0, 0.0);
+   vec4 axis = principal_axis(p4, mask, mean);
+   float tmin = 1e30, tmax = -1e30;
+   for (int i = 0; i < 16; i++) {
+      float t = dot(p4[i] - mean, axis);
+      tmin = min(tmin, t);
+      tmax = max(tmax, t);
+   }
+   vec3 e0 = clamp((mean + axis * tmin).rgb, 0.0, 65535.0);
+   vec3 e1 = clamp((mean + axis * tmax).rgb, 0.0, 65535.0);
+
+   float best_err = 1e30;
+   uvec4 best = uvec4(0u);
+   for (int iter = 0; iter < 3; iter++) {
+      uint v[6];
+      vec3 q0, q1;
+      hdr_quant_endpoints(e0, e1, v, q0, q1);
+
+      vec3 d = q1 - q0;
+      float dd = dot(d, d);
+      uint wv[32];
+      float wf[16];
+      float err = 0.0;
+      for (int i = 0; i < 16; i++) {
+         float t = dd > 0.0 ? dot(px[i] - q0, d) / dd : 0.0;
+         uint k = wt_level(WR_11, t);
+         float w = float(WT_UNQ[WR_11 * 32u + k]) / 64.0;
+         wf[i] = w;
+         wv[i] = WT_ISE[WR_11 * 32u + k];
+         vec3 diff = q0 + d * w - px[i];
+         err += dot(diff, diff);
+      }
+      if (err < best_err) {
+         best_err = err;
+         uint ev[32];
+         for (uint c = 0u; c < 32u; c++)
+            ev[c] = c < 6u ? v[c] : 0u;
+         best = astc_assemble(11u, false, 0u, WR_11, wv, ER_255, ev, 6u);
+      }
+
+      float a = 0.0, b = 0.0, c2 = 0.0;
+      vec3 x0 = vec3(0.0), x1 = vec3(0.0);
+      for (int i = 0; i < 16; i++) {
+         float w = wf[i], iw = 1.0 - w;
+         a += iw * iw; b += iw * w; c2 += w * w;
+         x0 += iw * px[i]; x1 += w * px[i];
+      }
+      float det = a * c2 - b * b;
+      if (abs(det) < 1e-6)
+         break;
+      e0 = clamp((c2 * x0 - b * x1) / det, 0.0, 65535.0);
+      e1 = clamp((a * x1 - b * x0) / det, 0.0, 65535.0);
+   }
+   return best;
+}
