+const uint ER_KIND[4] = uint[](1u, 1u, 0u, 0u);
+const uint ER_NB[4]   = uint[](4u, 6u, 6u, 8u);
+
+void put_bits(inout uvec4 b, uint off, uint v, uint n)
+{
+   for (uint i = 0u; i < n; i++) {
+      if (((v >> i) & 1u) != 0u) {
+         uint p = off + i;
+         b[p >> 5u] |= 1u << (p & 31u);
+      }
+   }
+}
+
+/* Integer sequence encoding (ASTC spec C.2.12). */
+uint ise_write(inout uvec4 b, uint off, uint vals[32], uint count, uint nb, uint kind)
+{
+   if (kind == 0u) {
+      for (uint i = 0u; i < count; i++) {
+         put_bits(b, off, vals[i], nb);
+         off += nb;
+      }
+      return off;
+   }
+
+   const uint gs = kind == 1u ? 5u : 3u;
+   const uint mask = (1u << nb) - 1u;
+   for (uint g = 0u; g < count; g += gs) {
+      uint m[5], t[5];
+      for (uint j = 0u; j < 5u; j++) {
+         uint v = (j < gs && g + j < count) ? vals[g + j] : 0u;
+         m[j] = v & mask;
+         t[j] = v >> nb;
+      }
+      uint packed = kind == 1u ?
+         TRIT_PACK[t[0] + 3u * t[1] + 9u * t[2] + 27u * t[3] + 81u * t[4]] :
+         QUINT_PACK[t[0] + 5u * t[1] + 25u * t[2]];
+      uint shift = 0u;
+      for (uint j = 0u; j < gs && g + j < count; j++) {
+         put_bits(b, off, m[j], nb);
+         off += nb;
+         uint tb = kind == 1u ? ((j == 2u || j == 4u) ? 1u : 2u) : (j == 0u ? 3u : 2u);
+         put_bits(b, off, packed >> shift, tb);
+         off += tb;
+         shift += tb;
+      }
+   }
+   return off;
+}
+
+/* Assemble a 4x4-weight, single-partition block. ev holds ISE endpoint
+ * values, wv ISE weight values (plane 0/1 interleaved when dual). */
+uvec4 astc_assemble(uint cem, bool dual, uint ccs, uint wr, uint wv[32],
+                    uint er, uint ev[32], uint ne)
+{
+   uvec4 b = uvec4(0u);
+   const uint R = WR_R[wr];
+   const uint mode = ((R >> 1u) & 3u) | ((R & 1u) << 4u) | (2u << 5u) |
+                     (WR_H[wr] << 9u) | ((dual ? 1u : 0u) << 10u);
+   b.x = mode | (cem << 13u);
+   ise_write(b, 17u, ev, ne, ER_NB[er], ER_KIND[er]);
+
+   uvec4 w = uvec4(0u);
+   uint wbits = ise_write(w, 0u, wv, dual ? 32u : 16u, WR_NB[wr], WR_KIND[wr]);
+   b |= uvec4(bitfieldReverse(w.w), bitfieldReverse(w.z),
+              bitfieldReverse(w.y), bitfieldReverse(w.x));
+   if (dual)
+      put_bits(b, 128u - wbits - 2u, ccs, 2u);
+   return b;
+}
+
+/* Quantise an endpoint (0..255); returns the ISE value, unq the decoded value. */
+uint ep_quant(uint er, float v, out float unq)
+{
+   v = clamp(v, 0.0, 255.0);
+   if (er == ER_255) {
+      uint r = uint(v + 0.5);
+      unq = float(r);
+      return r;
+   }
+   if (er == ER_63) {
+      uint best = 0u;
+      float be = 1e9;
+      int r0 = int(v * 63.0 / 255.0 + 0.5);
+      for (int r = max(r0 - 1, 0); r <= min(r0 + 1, 63); r++) {
+         float u = float((uint(r) << 2u) | (uint(r) >> 4u));
+         if (abs(u - v) < be) { be = abs(u - v); best = uint(r); unq = u; }
+      }
+      return best;
+   }
+   const int maxr = er == ER_47 ? 47 : 191;
+   int r0 = int(v * float(maxr) / 255.0 + 0.5);
+   uint best = 0u;
+   float be = 1e9;
+   for (int r = max(r0 - 1, 0); r <= min(r0 + 1, maxr); r++) {
+      float u = float(er == ER_47 ? E47_UNQ[r] : E191_UNQ[r]);
+      if (abs(u - v) < be) { be = abs(u - v); best = uint(r); unq = u; }
+   }
+   return er == ER_47 ? E47_ISE[best] : E191_ISE[best];
+}
+
+/* Nearest weight level for t in [0, 1]; returns the level index. */
+uint wt_level(uint wr, float t)
+{
+   float x = clamp(t, 0.0, 1.0) * 64.0;
+   uint best = 0u;
+   float be = 1e9;
+   for (uint k = 0u; k < WR_N[wr]; k++) {
+      float e = abs(float(WT_UNQ[wr * 32u + k]) - x);
+      if (e < be) { be = e; best = k; }
+   }
+   return best;
+}
+
+/* Principal axis of the masked channels, by power iteration. */
+vec4 principal_axis(vec4 px[16], vec4 mask, vec4 mean)
+{
+   mat4 cov = mat4(0.0);
+   vec4 lo = vec4(1e9), hi = vec4(-1e9);
+   for (int i = 0; i < 16; i++) {
+      vec4 d = (px[i] - mean) * mask;
+      cov += outerProduct(d, d);
+      lo = min(lo, px[i]);
+      hi = max(hi, px[i]);
+   }
+   vec4 axis = (hi - lo) * mask;
+   /* Seed with the box diagonal, but flip channels that fall while the
+    * dominant one rises so the seed is not orthogonal to the answer. */
+   vec4 row = cov * axis;
+   axis = (dot(row, row) > 1e-6) ? row : axis;
+   for (int it = 0; it < 8; it++) {
+      vec4 n = cov * axis;
+      float l = dot(n, n);
+      if (l < 1e-12)
+         break;
+      axis = n * inversesqrt(l);
+   }
+   float l = dot(axis, axis);
+   return l > 1e-12 ? axis * inversesqrt(l) : mask * 0.5;
+}
+
+/* Encode one candidate mode.
+ *   cem   ASTC colour endpoint mode (0 L, 4 LA, 8 RGB, 12 RGBA)
+ *   nch   endpoint channels (1, 2, 3, 4) taken from px.xyzw
+ *   dual  second weight plane for channel p1 (ccs)
+ * px is in 0..255; channels >= nch must already hold what the decoder will
+ * produce for them (they still count towards the error). Returns the
+ * squared error, the block in blk. */
+float astc_encode_mode(vec4 px[16], uint cem, uint nch, bool dual, uint p1,
+                       uint wr, uint er, out uvec4 blk)
+{
+   vec4 cmask = vec4(nch > 0u ? 1.0 : 0.0, nch > 1u ? 1.0 : 0.0,
+                     nch > 2u ? 1.0 : 0.0, nch > 3u ? 1.0 : 0.0);
+   vec4 pmask1 = vec4(0.0);
+   if (dual)
+      pmask1[p1] = 1.0;
+   vec4 pmask0 = cmask - pmask1;
+
+   vec4 mean = vec4(0.0);
+   for (int i = 0; i < 16; i++)
+      mean += px[i];
+   mean /= 16.0;
+
+   /* Initial endpoints: extremes along the principal axis (plane 0) and
+    * min/max of the dual-plane channel. */
+   vec4 axis = principal_axis(px, pmask0, mean);
+   float tmin = 1e9, tmax = -1e9;
+   float amin = 1e9, amax = -1e9;
+   for (int i = 0; i < 16; i++) {
+      float t = dot((px[i] - mean) * pmask0, axis);
+      tmin = min(tmin, t);
+      tmax = max(tmax, t);
+      if (dual) {
+         amin = min(amin, px[i][p1]);
+         amax = max(amax, px[i][p1]);
+      }
+   }
+   vec4 e0 = (mean + axis * tmin) * pmask0;
+   vec4 e1 = (mean + axis * tmax) * pmask0;
+   if (dual) {
+      e0[p1] = amin;
+      e1[p1] = amax;
+   }
+
+   float best_err = 1e30;
+   uvec4 best = uvec4(0u);
+
+   for (int iter = 0; iter < 3; iter++) {
+      /* Quantise endpoints. */
+      vec4 q0 = vec4(0.0), q1 = vec4(0.0);
+      uint i0[4], i1[4];
+      for (uint c = 0u; c < 4u; c++) {
+         i0[c] = 0u; i1[c] = 0u;
+         if (c < nch) {
+            float u;
+            i0[c] = ep_quant(er, e0[c], u); q0[c] = u;
+            i1[c] = ep_quant(er, e1[c], u); q1[c] = u;
+         }
+      }
+      /* RGB(A) direct modes blue-contract when endpoint 1 sums lower than
+       * endpoint 0; keep endpoint 1 the brighter one. */
+      if (cem >= 8u && q1.r + q1.g + q1.b < q0.r + q0.g + q0.b) {
+         vec4 tq = q0; q0 = q1; q1 = tq;
+         for (uint c = 0u; c < 4u; c++) { uint ti = i0[c]; i0[c] = i1[c]; i1[c] = ti; }
+      }
+
+      /* Weights against the quantised endpoints. */
+      vec4 d0 = (q1 - q0) * pmask0;
+      float dd = dot(d0, d0);
+      float d1 = dual ? q1[p1] - q0[p1] : 0.0;
+      uint wv[32];
+      float wf0[16], wf1[16];
+      float err = 0.0;
+      for (int i = 0; i < 16; i++) {
+         float t = dd > 0.0 ? dot((px[i] - q0) * pmask0, d0) / dd : 0.0;
+         uint k = wt_level(wr, t);
+         float w = float(WT_UNQ[wr * 32u + k]) / 64.0;
+         wf0[i] = w;
+         vec4 dec = q0 + (q1 - q0) * w;
+         if (dual) {
+            float ta = d1 != 0.0 ? (px[i][p1] - q0[p1]) / d1 : 0.0;
+            uint ka = wt_level(wr, ta);
+            float wa = float(WT_UNQ[wr * 32u + ka]) / 64.0;
+            wf1[i] = wa;
+            dec[p1] = q0[p1] + d1 * wa;
+            wv[2 * i] = WT_ISE[wr * 32u + k];
+            wv[2 * i + 1] = WT_ISE[wr * 32u + ka];
+         } else {
+            wv[i] = WT_ISE[wr * 32u + k];
+         }
+         vec4 diff = (dec - px[i]) * cmask;
+         err += dot(diff, diff);
+      }
+
+      if (err < best_err) {
+         best_err = err;
+         uint ev[32];
+         for (uint c = 0u; c < 32u; c++)
+            ev[c] = 0u;
+         for (uint c = 0u; c < nch; c++) {
+            ev[2u * c] = i0[c];
+            ev[2u * c + 1u] = i1[c];
+         }
+         /* CCS names the output component on plane 1: LA modes carry
+          * their second channel in alpha. */
+         uint ccs = cem == 4u ? 3u : p1;
+         best = astc_assemble(cem, dual, ccs, wr, wv, er, ev, 2u * nch);
+      }
+
+      /* Least-squares endpoint refit for the chosen weights. */
+      float a = 0.0, b = 0.0, c2 = 0.0;
+      vec4 x0 = vec4(0.0), x1 = vec4(0.0);
+      float aa = 0.0, ab = 0.0, ac = 0.0, ax0 = 0.0, ax1 = 0.0;
+      for (int i = 0; i < 16; i++) {
+         float w = wf0[i], iw = 1.0 - w;
+         a += iw * iw; b += iw * w; c2 += w * w;
+         x0 += iw * px[i]; x1 += w * px[i];
+         if (dual) {
+            float wa = wf1[i], iwa = 1.0 - wa;
+            aa += iwa * iwa; ab += iwa * wa; ac += wa * wa;
+            ax0 += iwa * px[i][p1]; ax1 += wa * px[i][p1];
+         }
+      }
+      float det = a * c2 - b * b;
+      if (abs(det) > 1e-6) {
+         e0 = clamp((c2 * x0 - b * x1) / det, 0.0, 255.0) * pmask0;
+         e1 = clamp((a * x1 - b * x0) / det, 0.0, 255.0) * pmask0;
+      } else {
+         e0 = q0 * pmask0;
+         e1 = q1 * pmask0;
+      }
+      if (dual) {
+         float deta = aa * ac - ab * ab;
+         e0[p1] = abs(deta) > 1e-6 ? clamp((ac * ax0 - ab * ax1) / deta, 0.0, 255.0) : q0[p1];
+         e1[p1] = abs(deta) > 1e-6 ? clamp((aa * ax1 - ab * ax0) / deta, 0.0, 255.0) : q1[p1];
+      }
+   }
+
+   blk = best;
+   return best_err;
+}
+
+/* Colour block (BC1-3, BC7). px in 0..255 RGBA. */
+uvec4 astc_encode_rgba(vec4 px[16])
+{
+   bool opaque = true;
+   for (int i = 0; i < 16; i++)
+      opaque = opaque && px[i].a >= 254.5;
+
+   uvec4 blk, cand;
+   if (opaque) {
+      /* Alpha decodes as 255 in RGB modes; it matches. */
+      astc_encode_mode(px, 8u, 3u, false, 0u, WR_15, ER_191, blk);
+      return blk;
+   }
+   float e = astc_encode_mode(px, 12u, 4u, false, 0u, WR_15, ER_47, blk);
+   float e2 = astc_encode_mode(px, 12u, 4u, true, 3u, WR_3, ER_47, cand);
+   return e2 < e ? cand : blk;
+}
+
+/* Two independent channels (BC5): x -> luminance, y -> alpha. Sample with
+ * an (X, W, 0, 1) swizzle. */
+uvec4 astc_encode_two_channel(vec2 v[16])
+{
+   vec4 px[16];
+   for (int i = 0; i < 16; i++) {
+      /* LA decodes as (L, L, L, A); only x and w are read through the
+       * swizzle, so score just L and A (kept in .x/.y here). */
+      px[i] = vec4(v[i], 0.0, 0.0);
+   }
+   uvec4 blk, cand;
+   float e = astc_encode_mode(px, 4u, 2u, true, 1u, WR_5, ER_63, blk);
+   float e2 = astc_encode_mode(px, 4u, 2u, true, 1u, WR_4, ER_255, cand);
+   if (e2 < e) { e = e2; blk = cand; }
+   e2 = astc_encode_mode(px, 4u, 2u, false, 0u, WR_15, ER_255, cand);
+   if (e2 < e) { e = e2; blk = cand; }
+   return blk;
+}
+
+/* One channel (BC4 UNORM): luminance, 32 weight levels, exact endpoints.
+ * Sample with an (X, 0, 0, 1) swizzle. */
+uvec4 astc_encode_one_channel(float v[16])
+{
+   vec4 px[16];
+   for (int i = 0; i < 16; i++)
+      px[i] = vec4(v[i], 0.0, 0.0, 0.0);
+   uvec4 blk;
+   astc_encode_mode(px, 0u, 1u, false, 0u, WR_31, ER_255, blk);
+   return blk;
+}
