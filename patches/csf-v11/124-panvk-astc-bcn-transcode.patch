+            wv[2 * i + 1] = WT_ISE[wr * 32u + ka];
+         } else {
+            wv[i] = WT_ISE[wr * 32u + k];
+         }
+         vec4 diff = (dec - px[i]) * cmask;
+         err += dot(diff, diff);
+      }
+
+      if (err < best_err) {
+         best_err = err;
+         uint ev[32];
+         for (uint c = 0u; c < 32u; c++)
+            ev[c] = 0u;
+         for (uint c = 0u; c < nch; c++) {
+            ev[2u * c] = i0[c];
+            ev[2u * c + 1u] = i1[c];
+         }
+         /* CCS names the output component on plane 1: LA modes carry
+          * their second channel in alpha. */
+         uint ccs = cem == 4u ? 3u : p1;
+         best = astc_assemble(cem, dual, ccs, wr, wv, er, ev, 2u * nch);
+      }
+
+      /* Least-squares endpoint refit for the chosen weights. */
+      float a = 0.0, b = 0.0, c2 = 0.0;
+      vec4 x0 = vec4(0.0), x1 = vec4(0.0);
+      float aa = 0.0, ab = 0.0, ac = 0.0, ax0 = 0.0, ax1 = 0.0;
+      for (int i = 0; i < 16; i++) {
+         float w = wf0[i], iw = 1.0 - w;
+         a += iw * iw; b += iw * w; c2 += w * w;
+         x0 += iw * px[i]; x1 += w * px[i];
+         if (dual) {
+            float wa = wf1[i], iwa = 1.0 - wa;
+            aa += iwa * iwa; ab += iwa * wa; ac += wa * wa;
+            ax0 += iwa * px[i][p1]; ax1 += wa * px[i][p1];
+         }
+      }
+      float det = a * c2 - b * b;
+      if (abs(det) > 1e-6) {
+         e0 = clamp((c2 * x0 - b * x1) / det, 0.0, 255.0) * pmask0;
+         e1 = clamp((a * x1 - b * x0) / det, 0.0, 255.0) * pmask0;
+      } else {
+         e0 = q0 * pmask0;
+         e1 = q1 * pmask0;
+      }
+      if (dual) {
+         float deta = aa * ac - ab * ab;
+         e0[p1] = abs(deta) > 1e-6 ? clamp((ac * ax0 - ab * ax1) / deta, 0.0, 255.0) : q0[p1];
+         e1[p1] = abs(deta) > 1e-6 ? clamp((aa * ax1 - ab * ax0) / deta, 0.0, 255.0) : q1[p1];
+      }
+   }
+
+   blk = best;
+   return best_err;
+}
+
+/* Colour block (BC1-3, BC7). px in 0..255 RGBA. */
+uvec4 astc_encode_rgba(vec4 px[16])
+{
+   bool opaque = true;
+   for (int i = 0; i < 16; i++)
+      opaque = opaque && px[i].a >= 254.5;
+
+   uvec4 blk, cand;
+   if (opaque) {
+      /* Alpha decodes as 255 in RGB modes; it matches. */
+      astc_encode_mode(px, 8u, 3u, false, 0u, WR_15, ER_191, blk);
+      return blk;
+   }
+   float e = astc_encode_mode(px, 12u, 4u, false, 0u, WR_15, ER_47, blk);
+   float e2 = astc_encode_mode(px, 12u, 4u, true, 3u, WR_3, ER_47, cand);
+   return e2 < e ? cand : blk;
+}
+
+/* Two independent channels (BC5): x -> luminance, y -> alpha. Sample with
+ * an (X, W, 0, 1) swizzle. */
+uvec4 astc_encode_two_channel(vec2 v[16])
+{
+   vec4 px[16];
+   for (int i = 0; i < 16; i++) {
+      /* LA decodes as (L, L, L, A); only x and w are read through the
+       * swizzle, so score just L and A (kept in .x/.y here). */
+      px[i] = vec4(v[i], 0.0, 0.0);
+   }
+   uvec4 blk, cand;
+   float e = astc_encode_mode(px, 4u, 2u, true, 1u, WR_5, ER_63, blk);
+   float e2 = astc_encode_mode(px, 4u, 2u, true, 1u, WR_4, ER_255, cand);
+   if (e2 < e) { e = e2; blk = cand; }
+   e2 = astc_encode_mode(px, 4u, 2u, false, 0u, WR_15, ER_255, cand);
+   if (e2 < e) { e = e2; blk = cand; }
+   return blk;
+}
+
+/* One channel (BC4 UNORM): luminance, 32 weight levels, exact endpoints.
+ * Sample with an (X, 0, 0, 1) swizzle. */
+uvec4 astc_encode_one_channel(float v[16])
+{
+   vec4 px[16];
+   for (int i = 0; i < 16; i++)
+      px[i] = vec4(v[i], 0.0, 0.0, 0.0);
+   uvec4 blk;
+   astc_encode_mode(px, 0u, 1u, false, 0u, WR_31, ER_255, blk);
+   return blk;
+}
+
+#define VK_FORMAT_BC1_RGB_UNORM_BLOCK 131
+#define VK_FORMAT_BC1_RGB_SRGB_BLOCK 132
+#define VK_FORMAT_BC1_RGBA_UNORM_BLOCK 133
+#define VK_FORMAT_BC1_RGBA_SRGB_BLOCK 134
+#define VK_FORMAT_BC2_UNORM_BLOCK 135
+#define VK_FORMAT_BC2_SRGB_BLOCK 136
+#define VK_FORMAT_BC3_UNORM_BLOCK 137
+#define VK_FORMAT_BC3_SRGB_BLOCK 138
+#define VK_FORMAT_BC4_UNORM_BLOCK 139
+#define VK_FORMAT_BC4_SNORM_BLOCK 140
+#define VK_FORMAT_BC5_UNORM_BLOCK 141
+#define VK_FORMAT_BC5_SNORM_BLOCK 142
+
+float decode_alpha_rgtc(uvec2 payload, int linear_pixel)
+{
+	float ep0 = float(int(payload.x & 0xffu)) / 255.0;
+	float ep1 = float(((payload.x >> 8) & 0xffu)) / 255.0;
+	bool range7 = ep0 > ep1;
+
+	int bit_offset = 16 + linear_pixel * 3;
+	uint bits;
+	if (bit_offset <= 29)
+		bits = bitfieldExtract(payload.x, bit_offset, 3);
+	else if (bit_offset >= 32)
+		bits = bitfieldExtract(payload.y, bit_offset - 32, 3);
+	else
+		bits = bitfieldExtract(payload.x, 31, 1) | ((payload.y & 3) << 1);
+
+	float res;
+	if (bits < 2)
+		res = bits != 0 ? ep1 : ep0;
+	else if (range7)
+		res = mix(ep0, ep1, (1.0 / 7.0) * float(bits - 1));
+	else if (bits > 5)
+		res = float(bits & 1);
+	else
+		res = mix(ep0, ep1, (1.0 / 5.0) * float(bits - 1));
+
+	return res;
+}
+
+float decode_alpha_rgtc_snorm(uvec2 payload, int linear_pixel)
+{
+   float ep0 = max(float(bitfieldExtract(int(payload.x), 0, 8)) / 127.0, -1.0);
+   float ep1 = max(float(bitfieldExtract(int(payload.x), 8, 8)) / 127.0, -1.0);
+   bool range7 = ep0 > ep1;
+   int bit_offset = 16 + linear_pixel * 3;
+   uint bits = bit_offset <= 29 ? bitfieldExtract(payload.x, bit_offset, 3) :
+               bit_offset >= 32 ? bitfieldExtract(payload.y, bit_offset - 32, 3) :
+               bitfieldExtract(payload.x, 31, 1) | ((payload.y & 3) << 1);
+   if (bits < 2)
+      return bits != 0 ? ep1 : ep0;
+   if (range7)
+      return mix(ep0, ep1, (1.0 / 7.0) * float(bits - 1));
+   if (bits > 5)
+      return bits == 6 ? -1.0 : 1.0;
+   return mix(ep0, ep1, (1.0 / 5.0) * float(bits - 1));
+}
+
+vec3 decode_endpoint_color(uint color)
+{
+    ivec3 c = ivec3(color) >> ivec3(11, 5, 0);
+    c &= ivec3(31, 63, 31);
+    return vec3(c) / vec3(31.0, 63.0, 31.0);
+}
+
+bool decode_endpoints_color(int format, uint payload, out vec3 ep0, out vec3 ep1)
+{
+    uint color0 = payload & 0xffffu;
+    uint color1 = payload >> 16u;
+    bool opaque_mode = (format > VK_FORMAT_BC1_RGBA_SRGB_BLOCK) || (color0 > color1);
+    ep0 = decode_endpoint_color(color0);
+    ep1 = decode_endpoint_color(color1);
+    return opaque_mode;
+}
+
+vec4 interpolate_endpoint_color(vec3 ep0, vec3 ep1, int bits, bool opaque_mode)
+{
+    vec4 res;
+    vec3 lerped;
+    if (opaque_mode)
+    {
+        if (bits < 2)
+            lerped = bits != 0 ? ep1 : ep0;
+        else
+            lerped = mix(ep0, ep1, (1.0 / 3.0) * float(bits - 1));
+        res = vec4(lerped, 1.0);
+    }
+    else
+    {
+        if (bits == 3)
+        {
+            res = vec4(0.0);
+        }
+        else
+        {
+            if (bits == 0)
+                lerped = ep0;
+            else if (bits == 1)
+                lerped = ep1;
+            else
+                lerped = 0.5 * (ep0 + ep1);
+            res = vec4(lerped, 1.0);
+        }
+    }
+    return res;
+}
+
+float decode_alpha_4bit(uvec2 payload, int pixel)
+{
+    uint offset = pixel * 4;
+    return float((payload[offset >> 5] >> (offset & 31)) & 0xf) / 15.0;
+}
+
+
+void main()
+{
+    uint bx = gl_GlobalInvocationID.x;
+    uint by = gl_GlobalInvocationID.y;
+    uint bz = gl_GlobalInvocationID.z;
+
+    uint num_blocks_x = uint((registers.width + 3) / 4);
+    uint num_blocks_y = uint((registers.height + 3) / 4);
+
+    if (bx >= num_blocks_x || by >= num_blocks_y || bz >= uint(registers.depth))
+        return;
+
+    InBuf ibuf = InBuf(registers.src);
+    OutBuf obuf = OutBuf(registers.dst);
+    int format = registers.format;
+
+    uint bw = (format <= VK_FORMAT_BC1_RGBA_SRGB_BLOCK || format == VK_FORMAT_BC4_UNORM_BLOCK) ? 2u : 4u;
+    uint in_word = (bz * registers.src_slice_B + by * registers.src_row_B) / 4u + bx * bw;
+
+    vec4 pixels[16];
+    if (format == VK_FORMAT_BC4_UNORM_BLOCK) {
+        uvec2 r_payload = uvec2(ibuf.data[in_word], ibuf.data[in_word + 1u]);
+        for (int p = 0; p < 16; p++)
+            pixels[p] = vec4(decode_alpha_rgtc(r_payload, p), 0.0, 0.0, 1.0);
+    } else if (format == VK_FORMAT_BC5_UNORM_BLOCK) {
+        uvec2 r_payload = uvec2(ibuf.data[in_word], ibuf.data[in_word + 1u]);
+        uvec2 g_payload = uvec2(ibuf.data[in_word + 2u], ibuf.data[in_word + 3u]);
+        for (int p = 0; p < 16; p++)
+            pixels[p] = vec4(decode_alpha_rgtc(r_payload, p), decode_alpha_rgtc(g_payload, p), 0.0, 1.0);
+    } else {
+        vec3 ep0, ep1;
+        uvec2 color_payload, alpha_payload;
+        if (bw == 2u) {
+            color_payload = uvec2(ibuf.data[in_word], ibuf.data[in_word + 1u]);
+        } else {
+            alpha_payload = uvec2(ibuf.data[in_word], ibuf.data[in_word + 1u]);
+            color_payload = uvec2(ibuf.data[in_word + 2u], ibuf.data[in_word + 3u]);
+        }
+        bool opaque_mode = decode_endpoints_color(format, color_payload.x, ep0, ep1);
+        for (int p = 0; p < 16; p++) {
+            int bits = int((color_payload.y >> (2 * p)) & 3u);
+            vec4 col = interpolate_endpoint_color(ep0, ep1, bits, opaque_mode);
+            /* BC1 without alpha: punch-through texels are opaque black. */
+            if (format == VK_FORMAT_BC1_RGB_UNORM_BLOCK || format == VK_FORMAT_BC1_RGB_SRGB_BLOCK)
+                col.a = 1.0;
+            else if (bw == 4u && format <= VK_FORMAT_BC2_SRGB_BLOCK)
+                col.a = decode_alpha_4bit(alpha_payload, p);
+            else if (bw == 4u)
+                col.a = decode_alpha_rgtc(alpha_payload, p);
+            pixels[p] = col;
+        }
+    }
+
+    uvec4 astc;
+    if (format == VK_FORMAT_BC4_UNORM_BLOCK) {
+        float v[16];
+        for (int p = 0; p < 16; p++)
+            v[p] = pixels[p].r * 255.0;
+        astc = astc_encode_one_channel(v);
+    } else if (format == VK_FORMAT_BC5_UNORM_BLOCK) {
+        vec2 v[16];
+        for (int p = 0; p < 16; p++)
+            v[p] = pixels[p].rg * 255.0;
+        astc = astc_encode_two_channel(v);
+    } else {
+        vec4 px[16];
+        for (int p = 0; p < 16; p++)
+            px[p] = pixels[p] * 255.0;
+        astc = astc_encode_rgba(px);
+    }
+
+    uint out_word = (bz * registers.dst_slice_B + by * registers.dst_row_B) / 4u + bx * 4u;
+    obuf.data[out_word + 0u] = astc.x;
+    obuf.data[out_word + 1u] = astc.y;
+    obuf.data[out_word + 2u] = astc.z;
+    obuf.data[out_word + 3u] = astc.w;
+}
