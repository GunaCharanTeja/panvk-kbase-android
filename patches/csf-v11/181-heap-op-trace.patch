 #include "vk_meta.h"
@@ -80,6 +82,27 @@ cmdbuf_skips_gpu_heap_ops(const struct panvk_cmd_buffer *cmdbuf)
    return phys_dev->kbase_node_path[0] != '\0' && !heap_ops;
 }
 
+/* PANVK_HEAP_TRACE=1: tally the heap operations emitted at record time
+ * (vt_start, vt_end, frag finish with increment, frag_end) to find render
+ * passes whose counts don't balance. Debug only. */
+static uint32_t heap_trace_counts[5];
+enum { HT_VT_START, HT_VT_END, HT_FINISH_INC, HT_FRAG_END, HT_FRAG_PASS };
+
+static void
+heap_trace(unsigned what)
+{
+   static int on = -1;
+   if (on < 0)
+      on = debug_get_bool_option("PANVK_HEAP_TRACE", false);
+   if (!on)
+      return;
+   uint32_t n = p_atomic_inc_return(&heap_trace_counts[what]);
+   if (what == HT_FRAG_PASS && (n % 512) == 0)
+      mesa_logi("heap trace: vt_start %u vt_end %u finish_inc %u frag_end %u frag_passes %u",
+                heap_trace_counts[HT_VT_START], heap_trace_counts[HT_VT_END],
+                heap_trace_counts[HT_FINISH_INC], heap_trace_counts[HT_FRAG_END], n);
+}
