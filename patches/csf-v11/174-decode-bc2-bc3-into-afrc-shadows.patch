+      .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+      .pNext = &view_usage,
+      .flags = VK_IMAGE_VIEW_CREATE_DRIVER_INTERNAL_BIT_MESA,
+      .image = img->bc_shadow,
+      .viewType = VK_IMAGE_VIEW_TYPE_2D_ARRAY,
+      .format = VK_FORMAT_R8G8B8A8_UNORM,
+      .subresourceRange = {
