+/* ---- BC2/BC3 into an AFRC shadow: fragment decode -------------------- */
+
+struct panvk_bc_afrc_push {
+   uint32_t src[2];
+   uint32_t src_row_B;
+   uint32_t src_slice_B;
+   int32_t x0;
+   int32_t y0;
+   int32_t bc2;
+};
+
+/* Where block (0, 0) of a decode region lives, and its pitches. */
+struct bc_decode_src {
+   uint64_t addr;
+   uint32_t row_B;
+   uint32_t slice_B;
+};
