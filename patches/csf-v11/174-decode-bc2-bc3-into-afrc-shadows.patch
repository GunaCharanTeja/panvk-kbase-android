+   const uint32_t w = MIN2(extent.width + (offset.x - x0), mip.width - x0);
+   const uint32_t h = MIN2(extent.height + (offset.y - y0), mip.height - y0);
+   const uint32_t layers = vk_image_subresource_layer_count(&img->vk, subres);
