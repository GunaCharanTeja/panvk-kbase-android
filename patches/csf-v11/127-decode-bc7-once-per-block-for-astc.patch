diff --git a/src/panfrost/vulkan/bc/panvk_bc_s3tc_astc.comp b/src/panfrost/vulkan/bc/panvk_bc_s3tc_astc.comp
index 3269699..fe73d20 100644
--- a/src/panfrost/vulkan/bc/panvk_bc_s3tc_astc.comp
+++ b/src/panfrost/vulkan/bc/panvk_bc_s3tc_astc.comp
@@ -404,26 +404,28 @@ float enc_line(uvec4 src, int format, uint cem, bool dual, uint wr, uint er, out
    if (dual) m1[p1] = 1.0;
    const vec4 m0 = cm - m1;
 
+   /* One pass: sums for the mean and the covariance (E[pp^T] - mean mean^T),
+    * texels scaled to 0..1 to keep the sums small. */
    vec4 mean = vec4(0.0);
+   mat4 cov = mat4(0.0);
    float amin = 1e9, amax = -1e9;
+   vec4 lo = vec4(1e9), hi = vec4(-1e9);
    for (uint i = 0u; i < 16u; i++) {
       vec4 p = chan(bc_texel(src, format, i), cem);
+      vec4 s = p * (1.0 / 255.0) * m0;
       mean += p;
+      cov += outerProduct(s, s);
       float a = dot(p, m1);
       amin = min(amin, a);
       amax = max(amax, a);
-   }
-   mean *= 1.0 / 16.0;
-
-   mat4 cov = mat4(0.0);
-   vec4 lo = vec4(1e9), hi = vec4(-1e9);
-   for (uint i = 0u; i < 16u; i++) {
-      vec4 p = chan(bc_texel(src, format, i), cem);
-      vec4 d = (p - mean) * m0;
-      cov += outerProduct(d, d);
       lo = min(lo, p);
       hi = max(hi, p);
    }
+   mean *= 1.0 / 16.0;
+   {
+      vec4 ms = mean * (1.0 / 255.0) * m0;
+      cov = cov - outerProduct(ms, ms) * 16.0;
+   }
    vec4 axis = (hi - lo) * m0;
    vec4 row = cov * axis;
    axis = dot(row, row) > 1e-6 ? row : axis;
