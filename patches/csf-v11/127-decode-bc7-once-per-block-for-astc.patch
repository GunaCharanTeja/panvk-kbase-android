-/* Encode one candidate mode.
- *   cem   ASTC colour endpoint mode (0 L, 4 LA, 8 RGB, 12 RGBA)
- *   nch   endpoint channels (1, 2, 3, 4) taken from px.xyzw
- *   dual  second weight plane for channel p1 (ccs)
- * px is in 0..255; channels >= nch must already hold what the decoder will
- * produce for them (they still count towards the error). Returns the
- * squared error, the block in blk. */
-float astc_encode_mode(vec4 px[16], uint cem, uint nch, bool dual, uint p1,
-                       uint wr, uint er, out uvec4 blk)
-{
-   vec4 cmask = vec4(nch > 0u ? 1.0 : 0.0, nch > 1u ? 1.0 : 0.0,
-                     nch > 2u ? 1.0 : 0.0, nch > 3u ? 1.0 : 0.0);
-   vec4 pmask1 = vec4(0.0);
-   if (dual)
-      pmask1[p1] = 1.0;
-   vec4 pmask0 = cmask - pmask1;
-
-   vec4 mean = vec4(0.0);
-   for (int i = 0; i < 16; i++)
-      mean += px[i];
-   mean /= 16.0;
-
-   /* Initial endpoints: extremes along the principal axis (plane 0) and
-    * min/max of the dual-plane channel. */
-   vec4 axis = principal_axis(px, pmask0, mean);
-   float tmin = 1e9, tmax = -1e9;
-   float amin = 1e9, amax = -1e9;
-   for (int i = 0; i < 16; i++) {
-      float t = dot((px[i] - mean) * pmask0, axis);
-      tmin = min(tmin, t);
-      tmax = max(tmax, t);
-      if (dual) {
-         amin = min(amin, px[i][p1]);
-         amax = max(amax, px[i][p1]);
-      }
-   }
-   vec4 e0 = (mean + axis * tmin) * pmask0;
-   vec4 e1 = (mean + axis * tmax) * pmask0;
-   if (dual) {
-      e0[p1] = amin;
-      e1[p1] = amax;
-   }
-
-   float best_err = 1e30;
-   uvec4 best = uvec4(0u);
-
-   for (int iter = 0; iter < 3; iter++) {
-      /* Quantise endpoints. */
-      vec4 q0 = vec4(0.0), q1 = vec4(0.0);
-      uint i0[4], i1[4];
-      for (uint c = 0u; c < 4u; c++) {
