-/* Single-partition ASTC 4x4 encoder shared by the BCn transcoders.
- *
- * Every block is encoded in each candidate mode the caller asks for; the
- * mode with the smallest squared error against the decoded BC texels wins.
- * Endpoints come from a principal-axis fit refined by least squares, so
- * colours stay on the block's real colour line instead of the per-channel
- * min/max box diagonal (which desaturates anything whose channels do not
- * rise together). */
-
-/* Weight ranges: index into WT_UNQ/WT_ISE (16 entries each). */
-#define WR_3   0u /* 0..3,  2 bits       */
-#define WR_4   1u /* 0..4,  quint        */
-#define WR_5   2u /* 0..5,  trit + 1 bit */
-#define WR_15  3u /* 0..15, 4 bits       */
-#define WR_11  4u /* 0..11, trit + 2 bits */
-#define WR_31  5u /* 0..31, 5 bits       */
-const uint WR_N[6]    = uint[](4u, 5u, 6u, 16u, 12u, 32u);
-const uint WR_KIND[6] = uint[](0u, 2u, 1u, 0u, 1u, 0u); /* 0 bits, 1 trits, 2 quints */
-const uint WR_NB[6]   = uint[](2u, 0u, 1u, 4u, 2u, 5u);
-const uint WR_R[6]    = uint[](4u, 5u, 6u, 4u, 3u, 7u);
-const uint WR_H[6]    = uint[](0u, 0u, 0u, 1u, 1u, 1u);
-
-/* Endpoint ranges. */
-#define ER_47  0u
-#define ER_191 1u
-#define ER_63  2u
-#define ER_255 3u
-const uint ER_KIND[4] = uint[](1u, 1u, 0u, 0u);
-const uint ER_NB[4]   = uint[](4u, 6u, 6u, 8u);
-
-void put_bits(inout uvec4 b, uint off, uint v, uint n)
-{
-   for (uint i = 0u; i < n; i++) {
-      if (((v >> i) & 1u) != 0u) {
-         uint p = off + i;
-         b[p >> 5u] |= 1u << (p & 31u);
-      }
-   }
-}
-
-/* Integer sequence encoding (ASTC spec C.2.12). */
-uint ise_write(inout uvec4 b, uint off, uint vals[32], uint count, uint nb, uint kind)
-{
-   if (kind == 0u) {
-      for (uint i = 0u; i < count; i++) {
-         put_bits(b, off, vals[i], nb);
-         off += nb;
-      }
-      return off;
-   }
-
-   const uint gs = kind == 1u ? 5u : 3u;
-   const uint mask = (1u << nb) - 1u;
-   for (uint g = 0u; g < count; g += gs) {
-      uint m[5], t[5];
-      for (uint j = 0u; j < 5u; j++) {
-         uint v = (j < gs && g + j < count) ? vals[g + j] : 0u;
-         m[j] = v & mask;
-         t[j] = v >> nb;
-      }
-      uint packed = kind == 1u ?
-         TRIT_PACK[t[0] + 3u * t[1] + 9u * t[2] + 27u * t[3] + 81u * t[4]] :
-         QUINT_PACK[t[0] + 5u * t[1] + 25u * t[2]];
-      uint shift = 0u;
-      for (uint j = 0u; j < gs && g + j < count; j++) {
-         put_bits(b, off, m[j], nb);
-         off += nb;
-         uint tb = kind == 1u ? ((j == 2u || j == 4u) ? 1u : 2u) : (j == 0u ? 3u : 2u);
-         put_bits(b, off, packed >> shift, tb);
-         off += tb;
-         shift += tb;
-      }
-   }
-   return off;
-}
-
-/* Assemble a 4x4-weight, single-partition block. ev holds ISE endpoint
- * values, wv ISE weight values (plane 0/1 interleaved when dual). */
-uvec4 astc_assemble(uint cem, bool dual, uint ccs, uint wr, uint wv[32],
-                    uint er, uint ev[32], uint ne)
-{
-   uvec4 b = uvec4(0u);
-   const uint R = WR_R[wr];
-   const uint mode = ((R >> 1u) & 3u) | ((R & 1u) << 4u) | (2u << 5u) |
-                     (WR_H[wr] << 9u) | ((dual ? 1u : 0u) << 10u);
-   b.x = mode | (cem << 13u);
-   ise_write(b, 17u, ev, ne, ER_NB[er], ER_KIND[er]);
-
-   uvec4 w = uvec4(0u);
-   uint wbits = ise_write(w, 0u, wv, dual ? 32u : 16u, WR_NB[wr], WR_KIND[wr]);
-   b |= uvec4(bitfieldReverse(w.w), bitfieldReverse(w.z),
-              bitfieldReverse(w.y), bitfieldReverse(w.x));
-   if (dual)
-      put_bits(b, 128u - wbits - 2u, ccs, 2u);
-   return b;
-}
