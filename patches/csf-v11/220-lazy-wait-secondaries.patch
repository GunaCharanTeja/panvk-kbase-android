+++ b/src/panfrost/vulkan/csf/panvk_cmd_buffer.h
@@ -620,6 +620,11 @@ struct panvk_cmd_buffer {
          bool pending;
          int32_t frag_sync_point;
       } lazy_wait[PANVK_SUBQUEUE_COUNT];
+      /* Subqueues (bits) whose deferred wait a primary must emit before
+       * executing this secondary: set by everything recorded here that
+       * would have emitted a pending deferred wait (see CmdExecuteCommands).
+       */
+      uint32_t lazy_exec_veto;
       struct panvk_tls_state tls;
       bool contains_timestamp_queries;
       /* CPU-side estimate used by the kbase queue to choose a conservative
@@ -1135,6 +1140,9 @@ static inline void
 panvk_cmd_lazy_vt_flush_pending(struct panvk_cmd_buffer *cmdbuf,
                                 enum panvk_lazy_vt_flush_reason reason)
 {
+   /* The end of a command buffer only flushes its own deferred waits. */
+   if (reason != PANVK_LAZY_VT_END)
+      cmdbuf->state.lazy_exec_veto |= BITFIELD_MASK(PANVK_SUBQUEUE_COUNT);
    for (uint32_t i = 0; i < PANVK_SUBQUEUE_COUNT; i++) {
       if (cmdbuf->state.lazy_wait[i].pending)
          panvk_per_arch(cmd_lazy_flush)(cmdbuf, i, reason);
diff --git a/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c b/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c
index 8a142639..e960c0c1 100644
--- a/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c
@@ -179,6 +179,14 @@ flush_sync_points(struct panvk_cmd_buffer *cmdbuf)
       }
    }
 
+   /* Deferred waits hold fragment sync points relative to the progress
+    * register, which just moved forward. */
+   for (uint32_t i = 0; i < PANVK_SUBQUEUE_COUNT; i++) {
+      if (cmdbuf->state.lazy_wait[i].pending)
+         cmdbuf->state.lazy_wait[i].frag_sync_point -=
+            cmdbuf->state.cs[PANVK_SUBQUEUE_FRAGMENT].relative_sync_point;
+   }
+
    for (uint32_t i = 0; i < ARRAY_SIZE(cmdbuf->state.cs); i++)
       cmdbuf->state.cs[i].relative_sync_point = 0;
 }
@@ -1062,6 +1070,7 @@ panvk_per_arch(cmd_lazy_flush)(struct panvk_cmd_buffer *cmdbuf,
                                enum panvk_subqueue_id subqueue,
                                enum panvk_lazy_vt_flush_reason reason)
 {
+   cmdbuf->state.lazy_exec_veto |= BITFIELD_BIT(subqueue);
    if (!cmdbuf->state.lazy_wait[subqueue].pending)
       return;
 
@@ -1089,6 +1098,10 @@ emit_barrier_csf(struct panvk_cmd_buffer *cmdbuf, struct panvk_cs_deps deps)
    uint32_t wait_subqueue_mask = 0;
    uint32_t utrace_subqueue_mask = 0;
 
+   /* A barrier in a secondary may need the primary's deferred waits
+    * (dependency chains). */
+   cmdbuf->state.lazy_exec_veto |= BITFIELD_MASK(PANVK_SUBQUEUE_COUNT);
+
    const uint32_t drop = drop_waits_mask();
    if (drop) {
       for (uint32_t i = 0; i < PANVK_SUBQUEUE_COUNT; i++)
@@ -1446,6 +1459,7 @@ panvk_per_arch(cmd_cut_vmr_segment)(struct panvk_cmd_buffer *cmdbuf)
    /* The primary's context split between segments moves its sync points:
     * the next segment must not carry relative ones across it.
     */
+   cmdbuf->state.lazy_exec_veto |= BITFIELD_MASK(PANVK_SUBQUEUE_COUNT);
    flush_sync_points(cmdbuf);
 
    struct panvk_vmr_segment *seg =
@@ -1678,6 +1692,20 @@ panvk_cmd_invalidate_state(struct panvk_cmd_buffer *cmdbuf)
    gfx_state_set_all_dirty(cmdbuf);
 }
 
+/* Deferred waits stay deferred across secondaries that recorded nothing
+ * that would have emitted them (lazy_exec_veto), on by default
+ * (PANVK_LAZY_EXEC=0 emits them before every secondary).  DXVK records the
+ * draws of each render pass into secondaries on tilers, so emitting them
+ * there made every pass's geometry wait for the previous fragment work. */
+static bool
+lazy_exec_enabled(void)
+{
+   static int enabled = -1;
+   if (enabled < 0)
+      enabled = debug_get_bool_option("PANVK_LAZY_EXEC", true);
+   return enabled;
+}
+
 VKAPI_ATTR void VKAPI_CALL
 panvk_per_arch(CmdExecuteCommands)(VkCommandBuffer commandBuffer,
                                    uint32_t commandBufferCount,
@@ -1685,7 +1713,20 @@ panvk_per_arch(CmdExecuteCommands)(VkCommandBuffer commandBuffer,
 {
    VK_FROM_HANDLE(panvk_cmd_buffer, primary, commandBuffer);
    panvk_cmd_rp_merge_flush_pending(primary);
-   panvk_cmd_lazy_vt_flush_pending(primary, PANVK_LAZY_VT_EXEC);
+
+   uint32_t veto = lazy_exec_enabled() ? 0 : BITFIELD_MASK(PANVK_SUBQUEUE_COUNT);
+   for (uint32_t i = 0; i < commandBufferCount; i++) {
+      VK_FROM_HANDLE(panvk_cmd_buffer, secondary, pCommandBuffers[i]);
+      veto |= secondary->state.lazy_exec_veto;
+      if (secondary->state.gfx.render.invalidate_inherited_ctx)
+         veto |= BITFIELD_MASK(PANVK_SUBQUEUE_COUNT);
+   }
+   /* A primary that is itself executed (nested) passes the veto on. */
+   primary->state.lazy_exec_veto |= veto;
+   u_foreach_bit(s, veto) {
+      if (primary->state.lazy_wait[s].pending)
+         panvk_per_arch(cmd_lazy_flush)(primary, s, PANVK_LAZY_VT_EXEC);
+   }
 
    if (commandBufferCount == 0)
       return;
